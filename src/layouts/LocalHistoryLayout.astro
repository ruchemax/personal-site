---
const {
  title = "Maksim Ruchkin",
  description = "Personal site",
  lang = "ru", // "en" | "ru" - по умолчанию русский для краеведения
} = Astro.props;

import "../styles/globals.css";

// меню для EN/RU
const menuEn = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Publications" },
  { href: "/software", label: "Software" },
  { href: "/ru/local_history", label: "Local history" },
  { href: "/contacts", label: "Contacts" },
];
const menuRu = [
  { href: "/ru", label: "Главная" },
  { href: "/ru/projects", label: "Проекты" },
  { href: "/ru/publications", label: "Публикации" },
  { href: "/ru/software", label: "Программы" },
  { href: "/ru/local_history", label: "Краеведение" },
  { href: "/ru/contacts", label: "Контакты" },
];
// По умолчанию используем русское меню, но на клиенте оно будет обновлено
const menu = menuRu;

// текущий путь и локализованные ссылки для переключателя
const path = Astro.url.pathname;              // напр. "/software" или "/ru/software" или "/"
const hrefRU = path.startsWith("/ru")
  ? path                                     // уже RU
  : (path === "/" ? "/ru" : `/ru${path}`);   // тот же путь с префиксом /ru
const hrefEN = path.startsWith("/ru")
  ? (path.slice(3) || "/")                   // убираем "/ru"
  : (path || "/");                           // уже EN

// Определяем язык на основе пути и сохраненных предпочтений
const currentLang = path.startsWith("/ru") ? "ru" : "en";
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Предзагрузка фоновых изображений -->
    <link rel="preload" as="image" href="/images/background/main-bg.webp" />
    <link rel="preload" as="image" href="/images/background/publications-bg.webp" />
    <link rel="preload" as="image" href="/images/background/projects-bg.webp" />
    <link rel="preload" as="image" href="/images/background/contacts-bg.webp" />
    <link rel="preload" as="image" href="/images/background/software-bg.webp" />
    <link rel="preload" as="image" href="/images/background/local-history-bg.webp" />
  </head>

  <body
    class="m-0 flex min-h-screen flex-col text-white bg-fixed bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-1000 ease-in-out"
    style="
      background-image:
        linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
        url('/images/background/local-history-bg.webp');
      background-color:#0b1220;
    "
  >
    <header class="sticky top-0 z-40 border-b border-white/10 bg-black/40 backdrop-blur">
      <nav class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-4">
        <a href={lang === "ru" ? "/ru" : "/"} class="flex items-center gap-2">
          <img src="/logo.svg" alt="Logo MR" class="h-8 w-8" />
          <span class="font-semibold text-white">Maksim Ruchkin</span>
        </a>

        <ul class="flex items-center gap-8 text-sm mx-auto">
          {menu.map((item) => (
            <li>
              <a class="text-white/85 hover:text-amber-400" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 p-4 text-sm text-white/70 text-left">
      © {new Date().getFullYear()} Maksim Ruchkin
    </footer>

    <script>
      // Простое сохранение языка при загрузке страницы краеведения
      document.addEventListener('DOMContentLoaded', function() {
        const currentPath = window.location.pathname;
        const currentLang = localStorage.getItem('preferredLanguage');
        
        // ОТЛАДКА: выводим информацию о языке
        console.log('LocalHistoryLayout - Текущий путь:', currentPath);
        console.log('LocalHistoryLayout - Сохраненный язык ДО:', currentLang);
        console.log('LocalHistoryLayout - localStorage содержимое ДО:', localStorage);
        
        // При загрузке страницы краеведения НЕ меняем предпочтение пользователя
        // Просто сохраняем текущий язык (если он уже был установлен)
        if (!currentLang) {
          // Если язык не был установлен ранее, устанавливаем русский по умолчанию
          localStorage.setItem('preferredLanguage', 'ru');
          console.log('LocalHistoryLayout - Установлен русский по умолчанию');
        } else {
          console.log('LocalHistoryLayout - Язык уже был установлен:', currentLang);
        }
        
        // Обновляем ссылки в меню на основе сохраненного языка
        const savedLang = localStorage.getItem('preferredLanguage');
        const menuLinks = document.querySelectorAll('nav a[href]');
        
        menuLinks.forEach(link => {
          const href = link.getAttribute('href');
          if (savedLang === 'en' && href.startsWith('/ru/') && !href.includes('/local_history')) {
            // Заменяем русские ссылки на английские
            const englishHref = href.replace('/ru', '') || '/';
            link.setAttribute('href', englishHref);
            console.log('LocalHistoryLayout - Обновлена ссылка:', href, '->', englishHref);
          }
        });
        
        // ОТЛАДКА: выводим финальное состояние
        console.log('LocalHistoryLayout - Сохраненный язык ПОСЛЕ:', localStorage.getItem('preferredLanguage'));
        console.log('LocalHistoryLayout - localStorage содержимое ПОСЛЕ:', localStorage);
        
        // Плавное появление фона после загрузки
        const body = document.body;
        const backgroundImage = new Image();
        
        backgroundImage.onload = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.onerror = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.src = '/images/background/local-history-bg.webp';
      });
    </script>
  </body>
</html>
