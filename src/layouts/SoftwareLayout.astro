---
const {
  title = "Software — Maksim Ruchkin",
  description = "Software",
  lang = "en", // "en" | "ru"
} = Astro.props;

import "../styles/globals.css";

// меню для EN/RU
const menuEn = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Publications" },
  { href: "/software", label: "Software" },
  { href: "/ru/local_history", label: "Local history" },
  { href: "/contacts", label: "Contacts" },
];
const menuRu = [
  { href: "/ru", label: "Главная" },
  { href: "/ru/projects", label: "Проекты" },
  { href: "/ru/publications", label: "Публикации" },
  { href: "/ru/software", label: "Программы" },
  { href: "/ru/local_history", label: "Краеведение" },
  { href: "/ru/contacts", label: "Контакты" },
];
const menu = lang === "ru" ? menuRu : menuEn;

// текущий путь и локализованные ссылки для переключателя
const path = Astro.url.pathname;              // напр. "/software" или "/ru/software" или "/"
const hrefRU = path.startsWith("/ru")
  ? path                                     // уже RU
  : (path === "/" ? "/ru" : `/ru${path}`);   // тот же путь с префиксом /ru
const hrefEN = path.startsWith("/ru")
  ? (path.slice(3) || "/")                   // убираем "/ru"
  : (path || "/");                           // уже EN

// Определяем язык на основе пути и сохраненных предпочтений
const currentLang = path.startsWith("/ru") ? "ru" : "en";
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Предзагрузка фоновых изображений -->
    <link rel="preload" as="image" href="/images/background/main-bg.webp" />
    <link rel="preload" as="image" href="/images/background/publications-bg.webp" />
    <link rel="preload" as="image" href="/images/background/projects-bg.webp" />
    <link rel="preload" as="image" href="/images/background/contacts-bg.webp" />
    <link rel="preload" as="image" href="/images/background/software-bg.webp" />
    <link rel="preload" as="image" href="/images/background/local-history-bg.webp" />
  </head>

  <body
    class="m-0 flex min-h-screen flex-col text-white bg-fixed bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-1000 ease-in-out"
    style="
      background-image:
        linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
        url('/images/background/software-bg.webp');
      background-color:#0b1220;
    "
  >
    <header class="sticky top-0 z-40 border-b border-white/10 bg-black/40 backdrop-blur">
      <nav class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-4">
        <a href={lang === "ru" ? "/ru" : "/"} class="flex items-center gap-2">
          <img src="/logo.svg" alt="Logo MR" class="h-8 w-8" />
          <span class="font-semibold text-white">Maksim Ruchkin</span>
        </a>

        <!-- Десктопное меню -->
        <ul class="hidden items-center gap-8 text-sm md:flex">
          {menu.map((item) => (
            <li>
              <a class="text-white/85 hover:text-amber-400" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>

        <!-- Переключатель языка: ведёт на тот же путь -->
        <div class="flex items-center gap-2">
          <div class="flex gap-2">
            <a
              href={hrefRU}
              class={`rounded-md border border-white/20 px-3 py-1 text-xs
                ${lang === 'ru' ? 'bg-amber-500 text-slate-950 font-semibold' : 'text-white/80 hover:bg-white/10'}`}
            >RU</a>
            <a
              href={hrefEN}
              class={`rounded-md border border-white/20 px-3 py-1 text-xs
                ${lang === 'en' ? 'bg-amber-500 text-slate-950 font-semibold' : 'text-white/80 hover:bg-white/10'}`}
            >EN</a>
          </div>
          
          <!-- Кнопка гамбургер-меню для мобильных -->
          <button id="mobileMenuBtn" class="md:hidden ml-2 p-2 text-white hover:text-amber-400 focus:outline-none" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              <path id="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Мобильное меню -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-black/60 backdrop-blur">
        <ul class="mx-auto max-w-[1200px] px-4 py-4 space-y-3">
          {menu.map((item) => (
            <li>
              <a class="block text-white/85 hover:text-amber-400 py-2 text-sm" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 p-4 text-sm text-white/70 text-left">
      © {new Date().getFullYear()} Maksim Ruchkin
    </footer>

    <script>
      // Управление языком и сохранение предпочтений
      document.addEventListener('DOMContentLoaded', function() {
        // Управление мобильным меню
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
          mobileMenuBtn.addEventListener('click', function() {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
              mobileMenu.classList.remove('hidden');
              menuIcon.classList.add('hidden');
              closeIcon.classList.remove('hidden');
            } else {
              mobileMenu.classList.add('hidden');
              menuIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
            }
          });
          
          // Закрываем меню при клике на ссылку
          const mobileMenuLinks = mobileMenu.querySelectorAll('a');
          mobileMenuLinks.forEach(link => {
            link.addEventListener('click', function() {
              mobileMenu.classList.add('hidden');
              menuIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
            });
          });
        }

        // Сохранение выбранного языка в localStorage
        const langLinks = document.querySelectorAll('a[href*="/ru"], a[href="/"]');
        
        langLinks.forEach(link => {
          link.addEventListener('click', function(e) {
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            console.log('SoftwareLayout - Клик по переключателю языка:', href);
            
            // НЕ меняем язык при переходе на краеведение
            if (href.includes('/local_history')) {
              console.log('SoftwareLayout - Переход на краеведение - НЕ меняем язык');
              return; // Не устанавливаем язык, просто переходим
            }
            
            if (href.startsWith('/ru')) {
              localStorage.setItem('preferredLanguage', 'ru');
              console.log('SoftwareLayout - Установлен русский язык');
            } else {
              localStorage.setItem('preferredLanguage', 'en');
              console.log('SoftwareLayout - Установлен английский язык');
            }
            
            console.log('SoftwareLayout - localStorage после клика:', localStorage.getItem('preferredLanguage'));
          });
        });

        // Проверка сохраненного языка при загрузке страницы
        const savedLang = localStorage.getItem('preferredLanguage');
        const currentPath = window.location.pathname;
        
        // ОТЛАДКА: выводим информацию о языке
        console.log('SoftwareLayout - Текущий путь:', currentPath);
        console.log('SoftwareLayout - Сохраненный язык:', savedLang);
        
        // Если пользователь переходит с краеведения на другую страницу
        // и у него сохранен английский язык, перенаправляем на английскую версию
        if (savedLang === 'en' && currentPath.startsWith('/ru/') && !currentPath.includes('/local_history')) {
          console.log('SoftwareLayout - Перенаправляем на английскую версию:', currentPath.replace('/ru', '') || '/');
          // Перенаправляем на английскую версию страницы
          const englishPath = currentPath.replace('/ru', '') || '/';
          window.location.href = englishPath;
        }

        // Обработка кликов по ссылкам в меню
        const menuLinks = document.querySelectorAll('nav a[href]');
        menuLinks.forEach(link => {
          link.addEventListener('click', function(e) {
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            const savedLang = localStorage.getItem('preferredLanguage');
            
            console.log('SoftwareLayout - Клик по ссылке в меню:', href);
            console.log('SoftwareLayout - Сохраненный язык при клике:', savedLang);
            
            // Устанавливаем язык в зависимости от того, на какую страницу переходим
            if (href.startsWith('/ru/') && !href.includes('/local_history')) {
              // Переход на русскую страницу (кроме краеведения) - устанавливаем русский язык
              localStorage.setItem('preferredLanguage', 'ru');
              console.log('SoftwareLayout - Установлен русский язык при переходе на русскую страницу');
            } else if (!href.startsWith('/ru/')) {
              // Переход на английскую страницу - устанавливаем английский язык
              localStorage.setItem('preferredLanguage', 'en');
              console.log('SoftwareLayout - Установлен английский язык при переходе на английскую страницу');
            }
            
            // Если пользователь с английской версии кликает на ссылку, ведущую на русскую страницу
            // (кроме краеведения), перенаправляем на английскую версию
            if (savedLang === 'en' && href.startsWith('/ru/') && !href.includes('/local_history')) {
              console.log('SoftwareLayout - Перенаправляем с русской на английскую версию');
              e.preventDefault();
              const englishPath = href.replace('/ru', '') || '/';
              console.log('SoftwareLayout - Новый путь:', englishPath);
              window.location.href = englishPath;
            } else {
              console.log('SoftwareLayout - Переход разрешен');
            }
          });
        });
        
        // Плавное появление фона после загрузки
        const body = document.body;
        const backgroundImage = new Image();
        
        backgroundImage.onload = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.onerror = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.src = '/images/background/software-bg.webp';
      });
    </script>
  </body>
</html>
