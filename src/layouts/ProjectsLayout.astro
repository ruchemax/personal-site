---
const {
  title = "Projects — Maksim Ruchkin",
  description = "Projects",
  lang = "en", // "en" | "ru"
} = Astro.props;

import "../styles/globals.css";

// Implementation note.
const menuEn = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/publications", label: "Publications" },
  { href: "/software", label: "Software" },
  { href: "/ru/local_history", label: "Local history" },
  { href: "/contacts", label: "Contacts" },
];
const menuRu = [
  { href: "/ru", label: "Главная" },
  { href: "/ru/projects", label: "Проекты" },
  { href: "/ru/publications", label: "Публикации" },
  { href: "/ru/software", label: "Программы" },
  { href: "/ru/local_history", label: "Краеведение и генеалогия" },
  { href: "/ru/contacts", label: "Контакты" },
];
const menu = lang === "ru" ? menuRu : menuEn;

// Implementation note.
const path = Astro.url.pathname;              // Implementation note.
const hrefRU = path.startsWith("/ru")
  ? path                                     // Already in Russian
  : (path === "/" ? "/ru" : `/ru${path}`);   // Implementation note.
const hrefEN = path.startsWith("/ru")
  ? (path.slice(3) || "/")                   // Implementation note.
  : (path || "/");                           // Implementation note.

// Implementation note.
const currentLang = path.startsWith("/ru") ? "ru" : "en";
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- UI section -->
    <link rel="preload" as="image" href="/images/background/main-bg.webp" />
    <link rel="preload" as="image" href="/images/background/publications-bg.webp" />
    <link rel="preload" as="image" href="/images/background/projects-bg.webp" />
    <link rel="preload" as="image" href="/images/background/contacts-bg.webp" />
    <link rel="preload" as="image" href="/images/background/software-bg.webp" />
  </head>

  <body
    class="m-0 flex min-h-screen flex-col text-white bg-fixed bg-cover bg-center bg-no-repeat opacity-0 transition-opacity duration-1000 ease-in-out"
    style="
      background-image:
        linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)),
        url('/images/background/projects-bg.webp');
      background-color:#0b1220;
    "
  >
    <header class="sticky top-0 z-40 border-b border-white/10 bg-black/40 backdrop-blur">
      <nav class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-4">
        <a href={lang === "ru" ? "/ru" : "/"} class="flex items-center gap-2">
          <img src="/logo.svg" alt="Logo MR" class="h-8 w-8" />
          <span class="font-semibold text-white">Maksim Ruchkin</span>
        </a>

        <!-- UI section -->
        <ul class="hidden items-center gap-8 text-sm md:flex">
          {menu.map((item) => (
            <li>
              <a class="text-white/85 hover:text-amber-400" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>

        <!-- UI section -->
        <div class="flex items-center gap-2">
          <div class="flex gap-2">
            <a
              href={hrefRU}
              class={`rounded-md border border-white/20 px-3 py-1 text-xs
                ${lang === 'ru' ? 'bg-amber-500 text-slate-950 font-semibold' : 'text-white/80 hover:bg-white/10'}`}
            >RU</a>
            <a
              href={hrefEN}
              class={`rounded-md border border-white/20 px-3 py-1 text-xs
                ${lang === 'en' ? 'bg-amber-500 text-slate-950 font-semibold' : 'text-white/80 hover:bg-white/10'}`}
            >EN</a>
          </div>
          
          <!-- UI section -->
          <button id="mobileMenuBtn" class="md:hidden ml-2 p-2 text-white hover:text-amber-400 focus:outline-none" aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="menuIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              <path id="closeIcon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </nav>

      <!-- UI section -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-white/10 bg-black/60 backdrop-blur">
        <ul class="mx-auto max-w-[1200px] px-4 py-4 space-y-3">
          {menu.map((item) => (
            <li>
              <a class="block text-white/85 hover:text-amber-400 py-2 text-sm" href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 p-4 text-sm text-white/70 text-left">
      © {new Date().getFullYear()} Maksim Ruchkin
    </footer>

    <script>
      // Implementation note.
      document.addEventListener('DOMContentLoaded', function() {
        // Implementation note.
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        const closeIcon = document.getElementById('closeIcon');
        
        if (mobileMenuBtn && mobileMenu && menuIcon && closeIcon) {
          mobileMenuBtn.addEventListener('click', function() {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
              mobileMenu.classList.remove('hidden');
              menuIcon.classList.add('hidden');
              closeIcon.classList.remove('hidden');
            } else {
              mobileMenu.classList.add('hidden');
              menuIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
            }
          });
          
          // Implementation note.
          const mobileMenuLinks = mobileMenu.querySelectorAll('a');
          mobileMenuLinks.forEach(link => {
            link.addEventListener('click', function() {
              mobileMenu.classList.add('hidden');
              menuIcon.classList.remove('hidden');
              closeIcon.classList.add('hidden');
            });
          });
        }

        // Implementation note.
        const langLinks = document.querySelectorAll('a[href*="/ru"], a[href="/"]');
        
        langLinks.forEach(link => {
          link.addEventListener('click', function(e) {
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            console.log('ProjectsLayout - Клик по переключателю языка:', href);
            
            // Implementation note.
            if (href.includes('/local_history')) {
              console.log('ProjectsLayout - Переход на краеведение - НЕ меняем язык');
              return; // Implementation note.
            }
            
            if (href.startsWith('/ru')) {
              localStorage.setItem('preferredLanguage', 'ru');
              console.log('ProjectsLayout - Установлен русский язык');
            } else {
              localStorage.setItem('preferredLanguage', 'en');
              console.log('ProjectsLayout - Установлен английский язык');
            }
            
            console.log('ProjectsLayout - localStorage после клика:', localStorage.getItem('preferredLanguage'));
          });
        });

        // Implementation note.
        const savedLang = localStorage.getItem('preferredLanguage');
        const currentPath = window.location.pathname;
        
        // Implementation note.
        console.log('ProjectsLayout - Текущий путь:', currentPath);
        console.log('ProjectsLayout - Сохраненный язык:', savedLang);
        
        // Implementation note.
        // Implementation note.
        if (savedLang === 'en' && currentPath.startsWith('/ru/') && !currentPath.includes('/local_history')) {
          console.log('ProjectsLayout - Перенаправляем на английскую версию:', currentPath.replace('/ru', '') || '/');
          // Implementation note.
          const englishPath = currentPath.replace('/ru', '') || '/';
          window.location.href = englishPath;
        }

        // Implementation note.
        const menuLinks = document.querySelectorAll('nav a[href]');
        menuLinks.forEach(link => {
          link.addEventListener('click', function(e) {
            const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
            if (!href) return;
            const savedLang = localStorage.getItem('preferredLanguage');
            
            console.log('ProjectsLayout - Клик по ссылке в меню:', href);
            console.log('ProjectsLayout - Сохраненный язык при клике:', savedLang);
            
            // Implementation note.
            if (href.startsWith('/ru/') && !href.includes('/local_history')) {
              // Implementation note.
              localStorage.setItem('preferredLanguage', 'ru');
              console.log('ProjectsLayout - Установлен русский язык при переходе на русскую страницу');
            } else if (!href.startsWith('/ru/')) {
              // Implementation note.
              localStorage.setItem('preferredLanguage', 'en');
              console.log('ProjectsLayout - Установлен английский язык при переходе на английскую страницу');
            }
            
            // Implementation note.
            // Implementation note.
            if (savedLang === 'en' && href.startsWith('/ru/') && !href.includes('/local_history')) {
              console.log('ProjectsLayout - Перенаправляем с русской на английскую версию');
              e.preventDefault();
              const englishPath = href.replace('/ru', '') || '/';
              console.log('ProjectsLayout - Новый путь:', englishPath);
              window.location.href = englishPath;
            } else {
              console.log('ProjectsLayout - Переход разрешен');
            }
          });
        });
        
        // Implementation note.
        const body = document.body;
        const backgroundImage = new Image();
        
        backgroundImage.onload = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.onerror = function() {
          body.style.opacity = '1';
        };
        
        backgroundImage.src = '/images/background/projects-bg.webp';
      });
    </script>
  </body>
</html>
