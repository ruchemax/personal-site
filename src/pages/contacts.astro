---
import ContactsLayout from "../layouts/ContactsLayout.astro";
---

<ContactsLayout title="Contacts — Maksim Ruchkin" lang="en">
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[800px] px-6 py-16">
      <h1 class="mb-8 text-3xl font-bold">Contact me</h1>

      <!-- Status box -->
      <div id="form-status" class="mb-4 hidden rounded-md border border-white/20 px-4 py-3 text-sm"></div>

      <form id="contact-form" method="POST" action="/api/contacts" class="space-y-4" novalidate>
        <!-- Honeypot spam protection -->
        <div class="absolute left-[-9999px] opacity-0 pointer-events-none">
          <label for="website">Don't fill this field</label>
          <input type="text" id="website" name="website" autocomplete="off" />
        </div>

        <!-- Name -->
        <div>
          <label for="name" class="mb-1 block text-sm">Your name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-md border border-white/20 bg-black/1 backdrop-blur px-3 py-2 text-white"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="mb-1 block text-sm">Your email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-md border border-white/20 bg-black/1 backdrop-blur px-3 py-2 text-white"
          />
        </div>

        <!-- Subject -->
        <div>
          <label for="subject" class="mb-1 block text-sm">Subject</label>
          <input
            id="subject"
            name="subject"
            type="text"
            required
            class="w-full rounded-md border border-white/20 bg-black/1 backdrop-blur px-3 py-2 text-white"
          />
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="mb-1 block text-sm">Message</label>
          <textarea
            id="message"
            name="message"
            rows="10"
            required
            class="w-full rounded-md border border-white/20 bg-black/1 backdrop-blur px-3 py-2 text-white"
          ></textarea>
        </div>

        <!-- Cloudflare Turnstile -->
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAB93lgc1IE7eRZFt" style="display: none;"></div>

        <!-- Submit -->
        <button
          type="submit"
          class="rounded-md bg-amber-500 px-6 py-2 font-semibold text-slate-950 hover:bg-amber-400"
        >
          Send
        </button>
      </form>
    </div>
  </section>

  <!-- AJAX submit with pretty status -->
  <script is:inline>
    const form = document.getElementById('contact-form');
    const statusBox = document.getElementById('form-status');

    function paintStatus(text, ok = true) {
      statusBox.classList.remove('hidden');
      statusBox.textContent = text;
      statusBox.className =
        'mb-4 rounded-md border px-4 py-3 text-sm ' +
        (ok
          ? 'border-emerald-400/30 bg-emerald-500/20 text-emerald-100'
          : 'border-red-400/30 bg-red-500/20 text-red-100');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      paintStatus('Sending…', true);

      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data?.success) {
          paintStatus('Your message has been sent. Thank you!', true);
          form.reset();
        } else {
          paintStatus('Failed to send. Please try again later.', false);
        }
      } catch {
        paintStatus('Network error. Please check your connection and try again.', false);
      }
    });
  </script>
</ContactsLayout>
