---
import BaseLayout from "../layouts/BaseLayout.astro";

type Pub = {
  title: string;
  authors: string;
  year?: number | null;   // null => In press
  venue: string;
  doi?: string;
  url?: string;
  type: "article" | "book" | "abstract" | "thesis";
};

/* ---------- DATA ---------- */
/* Journal articles */
const journals: Pub[] = [
  { title: "The Mga Formation of the Neva Lowland (St. Petersburg region): A Review",
    authors: "Ruchkin, M. V., Sheetov, M. V., Pleshivtseva, E. S., Ludikova, A. V., Taldenkova, E. E., Ovsepyan, Ya. S., Kosintsev, P. A., Merkuliev, A. V.",
    year: null, venue: "Stratigraphy and Geological Correlation", type: "journal" },
  { title: "The new key sections of the Last Interglacial transgression in the Eurasian Arctic (Eastern White Sea): paleoenvironmental reconstructions and interregional correlations",
    authors: "Zaretskaya, N. E., Taldenkova, Е. E., Ruchkin, M. V., Ovsepyan, Ya. S., Rudenko, O. V., Timofeeva, I. V.",
    year: null, venue: "Quaternary International", type: "journal" },
  { title: "Glaciolacustrine sedimentary settings and the MIS2 palaeogeography of the eastern White Sea",
    authors: "Zaretskaya, N. E., Vashkov, A. A., Baranov, D. V., Ruchkin, M. V., Nosova, O. Yu., Cherezova, A. A.",
    year: null, venue: "Geomorfologiya i Paleogeografiya", type: "journal" },
  { title: "Paleohydrological changes in the eastern Baltic Sea during the Middle/Late Pleistocene transition and the Last Interglacial",
    authors: "Ruchkin, M. V., Sheetov, M. V., Taldenkova, Е. E., Pushina, Z. V., Dudanova, V. I., Ovsepyan, Ya. S., Konstantinov, E. A., Nosevich, E. S., Mustafin, M. A.",
    year: 2025, venue: "Quaternary Science Reviews 360, 109244", doi: "10.1016/j.quascirev.2025.109244", type: "journal" },
  { title: "The Blake geomagnetic excursion recorded in the Mikulino Interglacial sediments of the Neva Lowland",
    authors: "Dudanova, V. I., Veselovskiy, R. V., Ruchkin, M. V., Sheetov, M. V.",
    year: 2024, venue: "Doklady Earth Sciences 514, 244–248", doi: "10.1134/S1028334X23602894", type: "journal" },
  { title: "Stratigraphy and OSL chronology of the Middle–Upper Pleistocene sedimentary sequence and vegetation history during Late MIS6 – MIS5e in the Neva Lowland (St. Petersburg Region, Russia)",
    authors: "Ruchkin, M. V., Nosevich, E. S., Sheetov, M. V., Brill, D.",
    year: 2024, venue: "Journal of Quaternary Science 39, 745–764", doi: "10.1002/jqs.3618", type: "journal" },
  { title: "The Azas ice sheet and its role in the formation of Late Pleistocene ice-dammed lakes in southern Siberia: case study of Upper Kharal paleolake",
    authors: "Novikov, I. S., Nazarov, D. V., Mikharevich, M. V., Gladysheva, A. S., Ruchkin, M. V., Prudnikov, S. G.",
    year: 2023, venue: "Geology and Geophysics 64, 595–606", doi: "10.2113/RGG20224494", type: "journal" },
  { title: "First data on the paleogeographical settings and chronology of the Last Interglacial on the Zimnii Coast of the White Sea",
    authors: "Zaretskaya, N. E., Taldenkova, Е. E., Ovsepyan, Ya. S., Ruchkin, M. V., Baranov, D. V., Rudenko, O. V., Stepanova, A. Yu.",
    year: 2023, venue: "Doklady Earth Sciences 512, 1059–1064", doi: "10.1134/S1028334X23601360", type: "journal" },
  { title: "Evidence for the intrusion of marine Atlantic waters into the West Siberian Arctic during the Middle Pleistocene",
    authors: "Nazarov, D. V., Nikolskaia, O. A., Gladysheva, A. S., Zhigmanovskiy, I. V., Ruchkin, M. V., Merkuljev, A. V., Thomsen, K. J.",
    year: 2022, venue: "Boreas 51, 402–425", doi: "10.1111/bor.12558", type: "journal" },
  { title: "Lake Yamal, an ice-dammed megalake in the West Siberian Arctic during the Late Pleistocene, ∼60–35 ka",
    authors: "Nazarov, D. V., Nikolskaia, O. A., Zhigmanovskiy, I. V., Ruchkin, M. V., Cherezova, A. A.",
    year: 2022, venue: "Quaternary Science Reviews 289, 107614", doi: "10.1016/j.quascirev.2022.107614", type: "journal" },
  { title: "The southeastern White Sea coast in the Late Pleistocene (in Russian)",
    authors: "Zaretskaya, N. E., Baranov, D. V., Ruchkin, M. V., Lugovoy, N. N.",
    year: 2022, venue: "Izvestiya RAN. Seriya Geograficheskaya 86, 898–913", doi: "10.31857/S2587556622060164", type: "journal" },
  { title: "Early Middle Weichselian in the White Sea and adjacent areas: Chronology, stratigraphy and palaeoenvironments",
    authors: "Zaretskaya, N. E., Korsakova, O. P., Molodkov, A. N., Ruchkin, M. V., Baranov, D. V., Rybalko, A. E., Lugovoy, N. N., Merkuljev, A. V.",
    year: 2022, venue: "Quaternary International 632, 65–78", doi: "10.1016/j.quaint.2022.05.007", type: "journal" },
  { title: "High-resolution analysis of the Likhvin loess–paleosol sequence (the central part of the East European Plain, Russia)",
    authors: "Panin, P. G., Filippova, K. G., Bukhonov, A. V., Karpukhina, N. V., Kalinin, P. I., Ruchkin, M. V.",
    year: 2021, venue: "Catena 205, 105445", doi: "10.1016/j.catena.2021.105445", type: "journal" },
  { title: "Cross-OSL and 14C dating of young subaerial peposits in the Sambia (Kaliningrad) Peninsula",
    authors: "Shvarev, S. V., Zaretskaya, N. E., Ruchkin, M. V., Lugovoy, N. N., Zazovskaya, E. P., Subetto, D. A.",
    year: 2021, venue: "Doklady Earth Sciences 499, 639–642", doi: "10.1134/S1028334X21080158", type: "journal" },
  { title: "Pleistocene marine formations of the lower Yenissei basin, Arctic Russia: OSL age, facial and paleontological characteristics (in Russian)",
    authors: "Nazarov, D. V., Nikolskaia, O. A., Gladysheva, A. S., Zhigmanovskiy, I. V., Ruchkin, M. V., Merkuljev, A. V.",
    year: 2020, venue: "Regional Geology and Metallogeny 82, 16–34",
    url: "https://karpinskyinstitute.ru/ru/public/reggeology_met/content/2020/82/82_02.pdf", type: "journal" },
];

/* Books */
const books: Pub[] = [
  { title: "Essays on the Quaternary geology of the Southern Ladoga Area and the Neva Lowland. Field guide for geological excursions of the XI All-Russian conference on Quaternary research, September 18–20, 2025 (in Russian)",
    authors: "Sheetov, M. V., Biske, Y. S., Bagdasaryan, T. E., Dudanova, V. I., Ruchkin, M. V., Sumareva, I. V., Shukhvostov, R. S. (Ed. Nazarov D. V.)",
    year: 2025, venue: "St. Petersburg: LEMA", type: "book" },
  { title: "State geological map of Russian Federation. Scale 1:1 000 000 (third generation). West Siberian seria. Quadrangle R-42, Yamal Peninsula. Explanatory notes (in Russian)",
    authors: "Shishkin, M. A., Faybusovich, Y. E., Shkarubo, S. I., Nazarov, D. V., Abakumova, L. A., Borozdina, Y. A., Voronin, A. S., Gerasicheva, A. V., Gorelina, T. E., Zavarzina, G. A., Zinchenko, A. G., Zuykova, O. N., Kostin, D. A., Lang, E. I., Likhotin, V. G., Markina, T. V., Petrov, S. Y., Petrova, M. N., Pushka, D. V., Radchenko, M. S., Rubin, L. I., Seregin, S.V., Solonina, S. F., Sychev, S. N., Tortsov, Y. I., Bazhkova, S. F., Vasilenko, E. P., Ivanova, E. I., Perlov, D. K., Ruchkin, M. V., Stepanova, A. P.",
    year: 2015, venue: "St. Petersburg: VSEGEI", type: "book" },
];

/* Conference abstracts / Theses (empty for now) */
const abstracts: Pub[] = [];
const theses: Pub[] = [];

/* Merge all for year grouping */
const pubs: Pub[] = [...journals, ...books, ...abstracts, ...theses];

/* Group by year: "In press" → 2025 → 2024 → ... */
const grouped = pubs.reduce((acc, p) => {
  const key = p.year == null ? "In press" : String(p.year);
  (acc[key] ??= []).push(p);
  return acc;
}, {} as Record<string, Pub[]>);

const years = Object.keys(grouped).sort((a, b) => {
  if (a === "In press") return -1;
  if (b === "In press") return 1;
  return Number(b) - Number(a);
});
---

<BaseLayout title="Publications — Maksim Ruchkin" lang="en">
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <h1 class="text-4xl font-bold">Publications</h1>

      <!-- Filter buttons: rounded, separate, no gaps -->
      <div id="filters" class="mt-6 flex flex-wrap space-x-0">
        <button
          data-type="journal"
          class="filter-chip active rounded-md border border-white/30 bg-white px-4 py-2 text-sm font-medium text-black"
        >
          Journal articles
        </button>
        <button
          data-type="book"
          class="filter-chip active rounded-md border border-white/30 bg-white px-4 py-2 text-sm font-medium text-black"
        >
          Books
        </button>
        <button
          data-type="abstract"
          class="filter-chip rounded-md border border-white/30 bg-white/80 px-4 py-2 text-sm font-medium text-black/70"
        >
          Conference abstracts
        </button>
        <button
          data-type="thesis"
          class="filter-chip rounded-md border border-white/30 bg-white/80 px-4 py-2 text-sm font-medium text-black/70"
        >
          Theses
        </button>
      </div>

      <!-- Publications grouped by year -->
      <div id="pubs" class="mt-8 space-y-10">
        {years.map((year) => (
          <section class="year-block" data-year={year}>
            <h2 class="text-2xl font-semibold border-b border-white/20 pb-1">{year}</h2>
            <ul class="mt-4 space-y-4">
              {grouped[year]
                // ensure rendering order: journal → book → abstract → thesis
                .sort((a,b)=>{
                  const order = {journal:0, book:1, abstract:2, thesis:3} as const;
                  return order[a.type]-order[b.type];
                })
                .map((p) => (
                <li
                  class="pub-item relative rounded-xl border border-white/10 bg-black/25 p-4 backdrop-blur"
                  data-type={p.type}
                >
                  <!-- Type badge (top-right) -->
                  <span class="absolute right-3 top-3 rounded-md border border-white/20 bg-white/90 px-2 py-0.5 text-[11px] font-medium text-black">
                    {p.type.charAt(0).toUpperCase() + p.type.slice(1)}
                  </span>

                  <div class="text-sm text-white/60">{p.venue}</div>
                  <h3 class="text-base font-semibold pr-24">{/* pr to avoid overlap with badge */}{p.title}</h3>
                  <div class="text-sm text-white/80">{p.authors}</div>

                  <div class="mt-2 flex flex-wrap gap-4">
                    {p.doi && (
                      <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                        DOI: {p.doi}
                      </a>
                    )}
                    {p.url && (
                      <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                        PDF
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side filter logic -->
  <script is:inline>
    // ordered chips: journal → book → abstract → thesis
    const chips = Array.from(document.querySelectorAll(".filter-chip"));
    const items = Array.from(document.querySelectorAll(".pub-item"));
    const yearBlocks = Array.from(document.querySelectorAll(".year-block"));

    function applyFilter() {
      const activeTypes = new Set(
        chips.filter(c => c.classList.contains("active")).map(c => c.dataset.type)
      );

      // show/hide items by type
      items.forEach(li => {
        const t = li.dataset.type;
        li.style.display = activeTypes.has(t) ? "" : "none";
      });

      // hide empty years
      yearBlocks.forEach(sec => {
        const visible = Array.from(sec.querySelectorAll(".pub-item"))
          .some(li => li.style.display !== "none");
        sec.style.display = visible ? "" : "none";
      });
    }

    function paintChips() {
      chips.forEach(c => {
        const isActive = c.classList.contains("active");
        // active: solid white, dark text, normal opacity
        if (isActive) {
          c.style.backgroundColor = "white";
          c.style.color = "black";
          c.style.opacity = "1";
          c.style.fontWeight = "600";
        } else {
          // inactive: still white but semi-transparent
          c.style.backgroundColor = "rgba(255,255,255,0.8)";
          c.style.color = "rgba(0,0,0,0.7)";
          c.style.opacity = "0.6";
          c.style.fontWeight = "500";
        }
      });
    }

    chips.forEach(chip => {
      chip.addEventListener("click", () => {
        chip.classList.toggle("active");

        // keep at least one chip active? — по ТЗ не требовалось; убрал автодобавление
        applyFilter();
        paintChips();
      });
    });

    // initial render: only journal + book active (так задано в разметке)
    applyFilter();
    paintChips();
  </script>
</BaseLayout>
