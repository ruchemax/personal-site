];

// Group by year (null → "In press")
const grouped = journals.reduce((acc, pub) => {
  const key = pub.year ? pub.year.toString() : "In press";
  if (!acc[key]) acc[key] = [];
  acc[key].push(pub);
  return acc;
}, {} as Record<string, Pub[]>);

const years = Object.keys(grouped).sort((a, b) => {
  if (a === "In press") return -1;
  if (b === "In press") return 1;
  return Number(b) - Number(a);
});
---

<BaseLayout title="Publications — Maksim Ruchkin" lang="en">
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <h1 class="text-4xl font-bold">Publications</h1>
      <p class="mt-3 max-w-2xl text-white/80">
        Journal articles grouped by year
      </p>

      {years.map((year) => (
        <section class="mt-10">
          <h2 class="text-2xl font-semibold border-b border-white/20 pb-1">
            {year}
          </h2>
          <ul class="mt-4 space-y-4">
            {grouped[year].map((p) => (
              <li class="rounded-xl border border-white/10 bg-black/25 p-4 backdrop-blur">
                <div class="text-sm text-white/60">{p.venue}</div>
                <h3 class="text-base font-semibold">{p.title}</h3>
                <div class="text-sm text-white/80">{p.authors}</div>
                {p.doi && (
                  <div class="mt-2">
                    <a
                      href={`https://doi.org/${p.doi}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-amber-400 hover:underline"
                    >
                      DOI: {p.doi}
                    </a>
                  </div>
                )}

                {p.url && (
                    <div class="mt-2">
                        <a
                        href={p.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-amber-400 hover:underline"
                        >
                        Full text
                        </a>
                    </div>
                    )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
