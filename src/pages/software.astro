---
import SoftwareLayout from "../layouts/SoftwareLayout.astro";

const { lang = "en" } = Astro.props;
---

<SoftwareLayout 
  title="Software — Maksim Ruchkin" 
  description="Software tools and applications developed for Quaternary geology research, luminescence dating, and data analysis."
  lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-16">
      <h1 class="text-4xl font-bold">Software</h1>

      <!-- Cards -->
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-1 lg:grid-cols-1">
        <!-- Card 1 -->
        <article class="rounded-2xl border border-white/10 bg-black/1 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          <h2 class="text-2xl font-semibold">Balta</h2>
          <p class="mt-2 text-base text-white/75">
            Balta is a scientific desktop application for processing and visualising
            grain-size distribution data used in Quaternary and palaeoenvironmental
            research.
          </p>

          <!-- Project links -->
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="https://github.com/ruchemax/Balta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-lg bg-amber-500 px-4 py-2 text-center text-base font-semibold text-slate-950 hover:bg-amber-400"
            >
              GitHub repository
            </a>
            <a
              href="https://github.com/ruchemax/Balta/releases/tag/v1.1.0"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-lg bg-amber-500 px-4 py-2 text-center text-base font-semibold text-slate-950 hover:bg-amber-400"
            >
              Balta v1.1.0
            </a>
          </div>

          <!-- Citation -->
          <div class="mt-4 text-sm text-white/70">
            The software is free to use; when using it, please cite this website as a reference:<br />
            <br />
            Ruchkin M. V. (2025) <i>Balta</i>. Scientific desktop application for processing and visualising grain-size distribution data. Available at:{" "}
            <a
              href="https://github.com/ruchemax/Balta"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-400 hover:underline"
            >
              https://github.com/ruchemax/Balta
            </a>
          </div>
        </article>
      </div>

      <!-- Contact -->
      <div class="mt-4 text-sm text-white/70">
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          Have found a bug? Have questions or feature requests?{" "}
          <a href="/contacts" class="text-amber-400 hover:underline">
            Write to me
          </a>
        </article>
      </div>
    </div>
  </section>
</SoftwareLayout>

