---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Maksim Ruchkin — Personal site" lang="en">
  <!-- English content -->

  <!-- Прозрачная секция: НИКАКИХ фоновых цветов, только контент -->
  <section class="relative w-full text-white">
    <div class="mx-auto grid w-full max-w-[1200px] grid-cols-1 gap-10 px-6 py-16 md:grid-cols-2 md:items-center">

      <!-- ЛЕВЫЙ столбец: фото -->
      <div class="relative mx-auto w-72">

        <!-- Фото в круге с оранжевым кантом -->
        <div class="aspect-square w-72 overflow-hidden rounded-full border-4 border-amber-500 shadow-2xl">
          <img src="/portrait.jpg" alt="Portrait of Maksim" class="h-full w-full object-cover" />
        </div>

        <!-- Кнопки -->
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/cv.pdf"
            class="min-w-[180px] text-center rounded-xl bg-amber-500 px-6 py-3 font-semibold text-slate-950 hover:bg-amber-400">
            Download CV
          </a>
        </div>
      </div>

      <!-- ПРАВЫЙ столбец: -->
      <div>
        <!-- Заголовок -->
        <h1 class="mt-4 text-4xl font-bold leading-tight md:text-4xl">
          Hi, I'm Maksim Ruchkin
        </h1>

        <!-- Подзаголовок -->
        <h2 class="mt-4 text-xl font-semibold leading-tight">
          PhD in Geography, Researcher in Quaternary Science
        </h2>

        <!-- Описание -->
        <p class="mt-4 max-w-xl text-white/80">
          My research interests are in the field of Quaternary geology and the paleogeography of Northern Europe, with a specific emphasis on luminescence dating. 
          My present study focuses on the Last Interglacial period in the Baltic region and the Late Glacial to Holocene history of Lake Schwerin in Germany. On this website, 
          you can find information about the projects I have worked on, links to my publications, software I have developed, as well as materials on the local history of the 
          Cherepovets region and my genealogy, which I research as a hobby.
        </p>

        <!-- Профили (иконки) -->
        <div class="mt-10 space-y-2 text-sm text-white/70">
          <div class="flex flex-wrap gap-4">
            <a href="https://www.scopus.com/authid/detail.uri?authorId=57223977950" target="_blank" rel="noopener noreferrer">
              <img src="/icons/scopus.svg" alt="Scopus" class="h-6 w-18 transition hover:opacity-80" />
            </a>
            <a href="https://www.webofscience.com/wos/author/record/ITT-5857-2023" target="_blank" rel="noopener noreferrer">
              <img src="/icons/wos.png" alt="Web of Science" class="h-6 w-18 transition hover:opacity-80" />
            </a>
            <a href="https://www.researchgate.net/profile/Maksim_Ruchkin" target="_blank" rel="noopener noreferrer">
              <img src="/icons/researchgate.png" alt="ResearchGate" class="h-6 w-18 transition hover:opacity-80" />
            </a>
            <a href="https://scholar.google.com/citations?user=sCTHWVwAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">
              <img src="/icons/scholar.png" alt="Google Scholar" class="h-6 w-18 transition hover:opacity-80" />
            </a>
            <a href="https://elibrary.ru/author_items.asp?authorid=1089388&show_refs=1" target="_blank" rel="noopener noreferrer">
              <img src="/icons/elibrary.png" alt="eLIBRARY" class="h-6 w-18 transition hover:opacity-80" />
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>



