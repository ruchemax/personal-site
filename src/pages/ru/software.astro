---
import BaseLayout from "../../layouts/BaseLayout.astro";

const { lang = "ru" } = Astro.props;
---

<BaseLayout title="Программы — Максим Ручкин" lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <h1 class="text-4xl font-bold">Программы</h1>
      <p class="mt-3 text-white/80 max-w-2xl">
        Программы и скрипты, которые я поддерживаю
      </p>

      <!-- Cards -->
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-2">
        <!-- Card 1 -->
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur w-full max-w-[500px]">
          <h2 class="text-xl font-semibold">Balta</h2>
          <p class="mt-2 text-sm text-white/75">
            Приложение для обработки данных гранулометрического анализа и построения графиков
          </p>

          <!-- Download button -->
          <div class="mt-4">
            <a
              href="/releases/balta-1.0.exe"
              download="Balta v1.0.exe"
              class="inline-block w-full max-w-[130px] text-center rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-amber-400"
            >
              Скачать v1.0
            </a>
          </div>

          <!-- Citation -->
          <div class="mt-4 text-xs text-white/70">
            Вы можете использовать программу бесплатно, однако, пожалуйста, указывайте ссылку на этот сайт:<br />
            Ручкин М.В., <i>Balta v1.0</i>. Доступно на:
            <a
              href="https://www.maksimruchkin.org/ru/software"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-400 hover:underline"
            >
              https://www.maksimruchkin.org/ru/software
            </a>
          </div>
        </article>
      </div>

      <!-- Contact -->
      <div class="mt-12 text-sm text-white/80">
        Есть вопросы или пожелания? Напишите мне через
        <a href="/ru/contact" class="text-amber-400 hover:underline">
          Контакты
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

