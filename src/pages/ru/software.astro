---
import BaseLayout from "../../layouts/BaseLayout.astro";

const { lang = "ru" } = Astro.props;
---

<BaseLayout title="Программы — Максим Ручкин" lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <h1 class="text-4xl font-bold">Программы</h1>
      <p class="mt-3 text-white/80 max-w-2xl">
        Приложения и скрипты, которые я поддерживаю
      </p>

      <!-- Cards -->
      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-1 lg:grid-cols-1">
        <!-- Card 1 -->
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          <h2 class="text-2xl font-semibold">Balta</h2>
          <p class="mt-2 text-base text-white/75">
            Приложение для обработки данных гранулометрического анализа и построения графиков
          </p>

          <!-- Download button -->
          <div class="mt-4">
            <a
              href="https://drive.proton.me/urls/PS29RK4WBM#K7RoDDoRpnl0"
              download="Balta v1.0.exe"
              class="inline-block w-full max-w-[130px] text-center rounded-lg bg-amber-500 px-3 py-2 text-base font-semibold text-slate-950 hover:bg-amber-400"
            >
              Скачать v1.0
            </a>
          </div>

          <!-- Citation -->
          <div class="mt-4 text-sm text-white/70">
            Программа распространяется бесплатно; при использовании, пожалуйста, указывайте следующую ссылку:<br />
            <br />
            Ручкин М.В. (2025) <i>Balta v1.0</i>. Приложение для обработки данных гранулометрического анализа и построения графиков. Доступно на:
            <a
              href="https://www.maxruchkin.org/software"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-400 hover:underline"
            >
              https://www.maxruchkin.org/software
            </a>
          </div>
        </article>
      </div>

      <!-- Contact -->
      <div class="mt-4 text-sm text-white/70">
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          Обнаружили ошибку? Есть вопросы или пожелания?
          <a href="/ru/contacts" class="text-amber-400 hover:underline">
            Напишите мне
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

