---
import SoftwareLayout from "../../layouts/SoftwareLayout.astro";

const { lang = "ru" } = Astro.props;
---

<SoftwareLayout 
  title="Программы — Максим Ручкин" 
  description="Программные инструменты и приложения, разработанные для исследований в области четвертичной геологии, люминесцентного датирования и анализа данных."
  lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-16">
      <h1 class="text-4xl font-bold">Программы</h1>

      <!-- Cards -->
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-1 lg:grid-cols-1">
        <!-- Card 1 -->
        <article class="rounded-2xl border border-white/10 bg-black/1 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          <h2 class="text-2xl font-semibold">Balta</h2>
          <p class="mt-2 text-base text-white/75">
            Balta — научное настольное приложение для обработки и визуализации
            данных гранулометрического анализа, используемых в четвертичной геологии
            и палеоэкологических исследованиях.
          </p>

          <!-- Project links -->
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="https://github.com/ruchemax/Balta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-lg bg-amber-500 px-4 py-2 text-center text-base font-semibold text-slate-950 hover:bg-amber-400"
            >
              GitHub repository
            </a>
            <a
              href="https://github.com/ruchemax/Balta/releases/tag/v1.1.0"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-lg bg-amber-500 px-4 py-2 text-center text-base font-semibold text-slate-950 hover:bg-amber-400"
            >
              Balta v1.1.0
            </a>
          </div>

          <!-- Citation -->
          <div class="mt-4 text-sm text-white/70">
            Программа распространяется бесплатно; при использовании, пожалуйста, указывайте следующую ссылку:<br />
            <br />
            Ручкин М.В. (2025) <i>Balta</i>. Приложение для обработки и визуализации данных гранулометрического анализа. Доступно на: 
            <a
              href="https://github.com/ruchemax/Balta"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-400 hover:underline"
            >
              https://github.com/ruchemax/Balta
            </a>
          </div>
        </article>
      </div>

      <!-- Contact -->
      <div class="mt-4 text-sm text-white/70">
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur w-full max-w-[550px]">
          Обнаружили ошибку? Есть вопросы или пожелания? 
          <a href="/ru/contacts" class="text-amber-400 hover:underline">
            Напишите мне
          </a>
        </article>
      </div>
    </div>
  </section>
</SoftwareLayout>
