---
import PublicationsLayout from "../../layouts/PublicationsLayout.astro";

type Pub = {
  title: string;
  authors: string;
  year?: number | null;   // null => In press
  venue: string;
  doi?: string;
  doiRu?: string;  // Russian version DOI
  doiEn?: string;  // English version DOI
  doiPP?: string;  // Preprint DOI
  url?: string;
  urlRu?: string;  // Russian version URL
  urlEn?: string;  // English version URL
  type: "journal" | "book" | "abstract" | "thesis";
};

/* ---------- ДАННЫЕ ---------- */
/* Статьи в журналах */
const journals: Pub[] = [
  { title: "Using portable luminescence profiling to refine 14C and OSL-based chronologies of lacustrine littoral sedimentary sequences: a case study from Schweriner See (NE Germany)",
    authors: "Ruchkin, M. V., Lorenz, S., Adolph, M.-L., Haberzettl, T.",
    year: 2026, venue: "Catena 271, 110209", doi: "10.1016/j.catena.2026.110209", type: "journal" },
  { title: "The enigma of unexpectedly young quartz OSL ages from Eemian marine clayey silt: hammering-related resetting?",
    authors: "Ruchkin, M. V.",
    year: null, venue: "Boreas", type: "journal" },
  { title: "The Mga Marine Formation of the Last Interglacial in the Neva Lowland (NW Russia): A Review",
    authors: "Ruchkin, M. V., Sheetov, M. V., Pleshivtseva, E. S., Ludikova, A. V., Taldenkova, E. E., Ovsepyan, Ya. S., Kosintsev, P. A., Merkuliev, A. V.",
    year: null, venue: "Quaternary International", type: "journal" },
  { title: "Early Eemian (Mikulino) rapid salinity increase in the Baltic Sea: Evidence for basin-wide synchronicity and application for correlating vegetation successions",
    authors: "Ruchkin, M. V., Taldenkova, Е. E., Ludikova, A. V., Sheetov, M. V.",
    year: null, venue: "Palaeogeography, Palaeoclimatology, Palaeoecology", type: "journal" },
  { title: "The new key sections of the Last Interglacial transgression in the Eurasian Arctic (Eastern White Sea): paleoenvironmental reconstructions and interregional correlations",
    authors: "Zaretskaya N. E., Taldenkova Е. E., Ruchkin M. V., Ovsepyan Ya. S., Rudenko O. P., Timofeeva I. V.",
    year: 2026, venue: "Quaternary International 754, 110067", doi: "10.1016/j.quaint.2025.110067", type: "journal" },
  { title: "Развитие и деградация последнего оледенения в восточном Прибеломорье",
    authors: "Зарецкая Н. Е., Вашков А. А., Баранов Д. В., Ручкин М. В., Носова О. Ю., Черезова А. А.",
    year: 2025, venue: "Геоморфология и палеогеография 56(4), 571–597", doi: "10.31857/S2949179725040031", type: "journal" },
  { title: "Paleohydrological changes in the eastern Baltic Sea during the Middle/Late Pleistocene transition and the Last Interglacial",
    authors: "Ruchkin M. V., Sheetov M. V., Taldenkova Е. E., Pushina Z. V., Dudanova V. I., Ovsepyan Y. S., Konstantinov E. A., Nosevich E. S., Mustafin M. A.",
    year: 2025, venue: "Quaternary Science Reviews 360, 109244", doi: "10.1016/j.quascirev.2025.109244", type: "journal" },
  { title: "Экскурс геомагнитного поля Блейк в разрезе микулинских межледниковых отложений Приневской низменности",
    authors: "Дуданова В. И., Веселовский Р. В., Ручкин М. В., Шитов М. В.",
    year: 2024, venue: "Доклады Академии Наук. Науки о Земле 514, 205–210", doiRu: "10.31857/S2686739724020029", doiEn: "10.1134/S1028334X23602894", type: "journal" },
  { title: "Stratigraphy and OSL chronology of the Middle–Upper Pleistocene sedimentary sequence and vegetation history during Late MIS6 – MIS5e in the Neva Lowland (St. Petersburg Region, Russia)",
    authors: "Ruchkin M. V., Nosevich E. S., Sheetov M. V., Brill D.",
    year: 2024, venue: "Journal of Quaternary Science 39, 745–764", doi: "10.1002/jqs.3618", type: "journal" },
  { title: "К проблеме воздействия Азасского ледникового щита на формирование подпрудных озер в неоплейстоцене Тувы на примере Верхнехаральского палеоозера",
    authors: "Новиков И. С., Назаров Д. В., Михаревич М. В., Гладышева А. С., Ручкин М. В., Предников С. Г.",
    year: 2023, venue: "Геология и геофизика 64, 720–734", doiRu: "10.15372/GiG2022146", doiEn: "10.2113/RGG20224494", type: "journal" },
  { title: "Первые данные о палеогеографических обстановках и хронологии последнего межледниковья на Зимнем берегу Белого моря",
    authors: "Зарецкая Н. Е., Талденкова Е. Е., Овсепян Я. С., Ручкин М. В., Баранов Д. В., Руденко О. В., Степанова А. Ю.",
    year: 2023, venue: "Доклады Академии Наук. Науки о Земле 512, 313–319", doiRu: "10.31857/S2686739723601308", doiEn: "10.1134/S1028334X23601360", type: "journal" },
  { title: "Evidence for the intrusion of marine Atlantic waters into the West Siberian Arctic during the Middle Pleistocene",
    authors: "Nazarov D. V., Nikolskaia O. A., Gladysheva A. S., Zhigmanovskiy I. V., Ruchkin M. V., Merkuljev A. V., Thomsen K. J.",
    year: 2022, venue: "Boreas 51, 402–425", doi: "10.1111/bor.12558", type: "journal" },
  { title: "Lake Yamal, an ice-dammed megalake in the West Siberian Arctic during the Late Pleistocene, ∼60–35 ka",
    authors: "Nazarov D. V., Nikolskaia O. A., Zhigmanovskiy I. V., Ruchkin M. V., Cherezova A. A.",
    year: 2022, venue: "Quaternary Science Reviews 289, 107614", doi: "10.1016/j.quascirev.2022.107614", type: "journal" },
  { title: "Побережье Белого моря в пределах Русской плиты в позднем неоплейстоцене",
    authors: "Зарецкая Н. Е., Баранов Д. В., Ручкин М. В., Луговой Н. Н.",
    year: 2022, venue: "Известия РАН. Серия географическая 86, 898–913", doi: "10.31857/S2587556622060164", type: "journal" },
  { title: "Early Middle Weichselian in the White Sea and adjacent areas: Chronology, stratigraphy and palaeoenvironments",
    authors: "Zaretskaya N. E., Korsakova O. P., Molodkov A. N., Ruchkin M. V., Baranov D. V., Rybalko A. E., Lugovoy N. N., Merkuljev A. V.",
    year: 2022, venue: "Quaternary International 632, 65–78", doi: "10.1016/j.quaint.2022.05.007", type: "journal" },
  { title: "High-resolution analysis of the Likhvin loess–paleosol sequence (the central part of the East European Plain, Russia)",
    authors: "Panin P. G., Filippova K. G., Bukhonov A. V., Karpukhina N. V., Kalinin P. I., Ruchkin M. V.",
    year: 2021, venue: "Catena 205, 105445", doi: "10.1016/j.catena.2021.105445", type: "journal" },
  { title: "Перекрестное ОСЛ- и 14С- датирование молодых субаэральных отложений Самбийского (Калининградского) полуострова",
    authors: "Шварёв С. В., Зарецкая Н. Е., Ручкин М. В., Луговой Н. Н., Зазовская Е. П., Субетто Д. А.",
    year: 2021, venue: "Доклады Академии Наук. Науки о Земле 499, 133-137", doiRu: "10.31857/S2686739721080156", doiEn: "10.1134/S1028334X21080158", type: "journal" },
  { title: "Плейстоценовые морские толщи бассейна нижнего Енисея: ОСЛ-возраст, фациальная и палеонтологическая характеристики",
    authors: "Назаров Д. В., Никольская О. А., Гладышева А. С., Жигмановский И. В., Ручкин М. В., Меркульев А. В.",
    year: 2020, venue: "Региональная геология и металлогения 82, 16–34",
    url: "https://karpinskyinstitute.ru/ru/public/reggeology_met/content/2020/82/82_02.pdf", type: "journal" },
];

/* Книги */
const books: Pub[] = [
  { title: "Очерки по геологии кватера Южного Приладожья и Приневской низменности. Путеводитель геологических экскурсий XI Всероссийской конференции по изучению четвертичного периода, 18–20 сентября 2025 г.",
    authors: "Шитов М. В., Бискэ Ю. С., Багдасарян Т. Е., Дуданова В. И., Ручкин М. В., Сумарева И. В., Шухвостов Р. С. (ред. Назаров Д. В.)",
    year: 2025, venue: "Санкт-Петербург: ЛЕМА", url: "/papers/sheetov-2025.pdf", type: "book" },
  { title: "Государственная геологическая карта Российской Федерации. Масштаб 1 : 1 000 000 (третье поколение). Серия Западно-Сибирская. Лист R-42 – п-ов Ямал. Объяснительная записка",
    authors: "Шишкин М. А., Файбусович Я. Э., Шкарубо С. И., Назаров Д. В., Абакумова Л. А., Бороздина Ю. А., Воронин А. С., Герасичева А. В., Горелина Т. Е., Заварзина Г. А., Зинченко А. Г., Зуйкова О. Н., Костин Д. А., Ланг Е. И., Лихотин В. Г., Маркина Т. В., Петров С. Ю., Петрова М. Н., Пушка Д. В., Радченко М. С., Рубин Л. И., Серегин С. В., Солонина С. Ф., Сычев С. Н., Торцов Ю. И., Бажкова С. Ф., Василенко Е. П., Иванова Э. И., Перлов Д. К., Ручкин М. В., Степанова А. П.",
    year: 2015, venue: "Санкт-Петербург: Картографическая фабрика ВСЕГЕИ", url: "https://webftp.vsegei.ru/GGK1000/R-42/R-42_ObZap.pdf", type: "book" },
];

/* Материалы конференций / Диссертации */
const abstracts: Pub[] = [];
const theses: Pub[] = [
  { title: "Хронология и условия формирования мгинской морской межледниковой толщи в Приневской низменности",
    authors: "Ручкин М. В.",
    year: 2024, venue: "Диссертация на соискание учёной степени кандидата географических наук. СПбГУ", 
    urlRu: "https://disser.spbu.ru/files/2024/disser_ruchkin_maksim.pdf", 
    urlEn: "https://disser.spbu.ru/files/2024/disser_en_ruchkin_maksim.pdf", 
    type: "thesis" },
];

/* Объединяем для группировки по годам */
const pubs: Pub[] = [...journals, ...books, ...abstracts, ...theses];

/* Группировка по годам: «В печати» → 2025 → 2024 → ... */
const grouped = pubs.reduce((acc, p) => {
  const key = p.year == null ? "В печати" : String(p.year);
  (acc[key] ??= []).push(p);
  return acc;
}, {} as Record<string, Pub[]>);

const years = Object.keys(grouped).sort((a, b) => {
  if (a === "В печати") return -1;
  if (b === "В печати") return 1;
  return Number(b) - Number(a);
});

// Человеко-понятные подписи типов для бейджа
const typeLabel = (t: Pub["type"]) =>
  t === "journal" ? "Статья"
  : t === "book" ? "Книга"
  : t === "abstract" ? "Тезисы"
  : "Диссертация";
---

<PublicationsLayout 
  title="Публикации — Максим Ручкин" 
  description="Научные публикации, включая статьи в журналах, книги, тезисы и диссертации по четвертичной геологии, палеогеографии и люминесцентному датированию."
  lang="ru">
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-16">
      <h1 class="text-4xl font-bold">Публикации</h1>

      <!-- Кнопки фильтра: отдельные, белые, с рамкой, без зазоров; по умолчанию активны Журнальные и Книги -->
      <div id="filters" class="mt-6 flex flex-wrap space-x-0">
        <button data-type="journal" class="filter-chip active rounded-md border border-white/30 bg-white px-4 py-2 text-sm font-medium text-black">
          Статьи в журналах
        </button>
        <button data-type="book" class="filter-chip active rounded-md border border-white/30 bg-white px-4 py-2 text-sm font-medium text-black">
          Книги
        </button>
        <button data-type="abstract" class="filter-chip rounded-md border border-white/30 bg-white/80 px-4 py-2 text-sm font-medium text-black/70">
          Материалы конференций
        </button>
        <button data-type="thesis" class="filter-chip active rounded-md border border-white/30 bg-white px-4 py-2 text-sm font-medium text-black">
          Диссертации
        </button>
      </div>

      <!-- Публикации по годам -->
      <div id="pubs" class="mt-8 space-y-10">
        {years.map((year) => (
          <section class="year-block" data-year={year}>
            <h2 class="text-2xl font-semibold border-b border-white/20 pb-1">{year}</h2>
            <ul class="mt-4 space-y-4">
              {grouped[year]
                // Порядок внутри года: статьи → книги → тезисы → диссертации
                .sort((a,b) => {
                  const order = {journal:0, book:1, abstract:2, thesis:3} as const;
                  return order[a.type] - order[b.type];
                })
                .map((p) => (
                <li class="pub-item relative rounded-xl border border-white/10 bg-black/1 p-4 backdrop-blur" data-type={p.type}>
                  <!-- Бейдж типа (справа сверху) -->
                  <span class="absolute right-3 top-3 rounded-md border border-white/20 bg-white/90 px-2 py-0.5 text-[11px] font-medium text-black">
                    {typeLabel(p.type)}
                  </span>

                  <div class="text-sm text-white/60">{p.venue}</div>
                  <h3 class="text-base font-semibold pr-24">{p.title}</h3>
                  <div class="text-sm text-white/80">{p.authors}</div>

                  <div class="mt-2 flex flex-wrap gap-4">
                    {p.doi && (
                      <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                        DOI: {p.doi}
                      </a>
                    )}
                    {p.doiRu && (
                      <span>
                        <span class="text-white">RUS </span>
                        <a href={`https://doi.org/${p.doiRu}`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                          DOI: {p.doiRu}
                        </a>
                      </span>
                    )}
                    {p.doiEn && (
                      <span>
                        <span class="text-white">ENG </span>
                        <a href={`https://doi.org/${p.doiEn}`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                          DOI: {p.doiEn}
                        </a>
                      </span>
                    )}
                    {p.url && (
                      <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                        PDF
                      </a>
                    )}
                    {p.urlRu && (
                      <span>
                        <span class="text-white">RUS </span>
                        <a href={p.urlRu} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                          PDF
                        </a>
                      </span>
                    )}
                    {p.urlEn && (
                      <span>
                        <span class="text-white">ENG </span>
                        <a href={p.urlEn} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                          PDF
                        </a>
                      </span>
                    )}
                    {p.doiPP && (
                      <span>
                        <span class="text-white">ПРЕПРИНТ </span>
                        <a href={`https://doi.org/${p.doiPP}`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:underline">
                          DOI: {p.doiPP}
                        </a>
                      </span>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Логика фильтрации на клиенте -->
  <script is:inline>
    const chips = Array.from(document.querySelectorAll(".filter-chip"));
    const items = Array.from(document.querySelectorAll(".pub-item"));
    const yearBlocks = Array.from(document.querySelectorAll(".year-block"));

    function applyFilter() {
      const activeTypes = new Set(
        chips.filter(c => c.classList.contains("active")).map(c => c.dataset.type)
      );
      // показать/скрыть элементы по типу
      items.forEach(li => {
        li.style.display = activeTypes.has(li.dataset.type) ? "" : "none";
      });
      // скрыть пустые годы
      yearBlocks.forEach(sec => {
        const visible = Array.from(sec.querySelectorAll(".pub-item"))
          .some(li => li.style.display !== "none");
        sec.style.display = visible ? "" : "none";
      });
    }

    function paintChips() {
      chips.forEach(c => {
        const on = c.classList.contains("active");
        c.style.backgroundColor = on ? "white" : "rgba(255,255,255,0.9)";
        c.style.color = on ? "black" : "rgba(0,0,0,0.7)";
        c.style.opacity = on ? "1" : "0.7";
        c.style.fontWeight = on ? "600" : "500";
      });
    }

    chips.forEach(c => c.addEventListener("click", () => {
      c.classList.toggle("active");
      applyFilter(); paintChips();
    }));

    // старт: активны «Статьи» и «Книги»
    applyFilter();
    paintChips();
  </script>
</PublicationsLayout>
