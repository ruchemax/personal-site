---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";
import sourceText from "../../../data/chebarkul-confession-1773.txt?raw";
import documentHtml from "../../../data/chebarkul-confession-1773.html?raw";

const { lang = "ru" } = Astro.props;

const publishedAt = new Date("2026-08-24").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const entries = sourceText.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
const headings = entries
  .map((text, index) => ({ text, index }))
  .filter(({ text, index }) => index > 0 && text.endsWith(":"));
---

<LocalHistoryLayout
  title="Исповедная ведомость Преображенской церкви Чебаркульской крепости (1773 г.) — Максим Ручкин"
  description="Исповедная ведомость Преображенской церкви Чебаркульской крепости за 1773 год: духовенство, военные, казаки и жители прихода."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 pb-12 pt-4">
      <article class="paper-old shadow-2xl">
        <div class="relative z-10">
          <p class="mb-4 text-xs text-gray-600">Опубликовано: {publishedAt}</p>

          <h1 class="mb-2 text-2xl font-bold text-slate-800">
            Исповедная ведомость Преображенской церкви Чебаркульской крепости (1773 г.)
          </h1>

          <div class="mb-6 mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Оренбургская губерния</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Исетская провинция</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Чебаркульская крепость</span>
          </div>

          <p class="text-sm text-right italic text-slate-700">
            <a
              href="https://yandex.ru/archive/catalog/c505bcbb-78ab-44f8-9110-67aa1fef9ee5/1"
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-700 underline"
            >
              ОГАОО. Ф. 173. Оп. 11. Д. 28. Лл. 1–29.
            </a>
          </p>

          <div class="mt-3 space-y-3 text-sm text-slate-800 leading-relaxed mb-8 text-right">
            <p class="italic">Прочтение: М.В. Ручкин</p>
          </div>

          <div id="contents" class="mb-8 scroll-mt-20 border-b border-amber-800/30 pb-6">
            <h2 class="mb-4 text-xl font-semibold text-slate-800">Содержание</h2>
            <div class="space-y-2 text-sm">
              {headings.map((heading) => (
                <div>
                  <a href={`#section-${heading.index}`} class="text-amber-700 underline">
                    {heading.text.replace(/^\(л\.\s*[^)]+\)\s*/, "").replace(/:$/, "")}
                  </a>
                </div>
              ))}
            </div>
          </div>

          <div class="document-body text-base leading-tight" set:html={documentHtml} />

        </div>
      </article>

      <div class="mt-10">
        <a href="/ru/local_history/southern-urals" class="inline-block rounded-lg border border-white/20 bg-black/30 px-4 py-2 text-sm text-white/80 hover:bg-white/10">
          ← Назад к разделу «Южный Урал»
        </a>
      </div>
    </div>

    <a href="#contents" class="toc-return" aria-label="Вернуться к содержанию">
      ↑ К содержанию
    </a>
  </section>

  <style>
    .paper-old {
      position: relative;
      overflow: hidden;
      padding: 2rem;
      border-radius: 0;
      color: #2a1e14;
      background-color: #f3e4c9;
      background-image:
        linear-gradient(rgba(255, 255, 255, .16), rgba(255, 255, 255, .16)),
        url('/images/textures/old-paper.webp');
      background-position: center;
      background-repeat: repeat;
      box-shadow: 0 20px 40px rgba(0, 0, 0, .35), inset 0 0 140px rgba(0, 0, 0, .22), inset 0 0 24px rgba(0, 0, 0, .12);
      filter: saturate(1.05) contrast(1.02);
    }

    .paper-old::before {
      position: absolute;
      inset: 0;
      content: "";
      pointer-events: none;
      background: rgba(255, 255, 255, .68);
      mix-blend-mode: screen;
    }

    .paper-old .text-white,
    .paper-old .text-white * {
      color: #2a1e14 !important;
    }

    .document-body {
      max-width: 820px;
      margin-right: auto;
      margin-left: auto;
      color: #2a1e14;
      font-size: .9375rem;
      line-height: 1.58;
    }

    .document-body :global(.document-heading) {
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      padding-bottom: .5rem;
      border-bottom: 1px solid rgba(146, 64, 14, .35);
      scroll-margin-top: 5rem;
      color: #b45309;
      font-size: 1.0625rem;
      font-weight: 600;
      line-height: 1.5;
    }

    .document-body :global(.document-heading strong) {
      font-weight: 600;
    }

    .document-body :global(.document-heading em) {
      font-size: .9375rem;
      font-weight: 400;
    }

    .document-body :global(.document-entry:first-child strong) {
      font-weight: 400;
    }

    .document-body :global(.document-entry) {
      margin-top: .5rem;
      margin-bottom: .5rem;
    }

    .document-body :global(.household-entry) {
      margin-top: .1rem;
      margin-bottom: .1rem;
      padding: .8rem 1rem .8rem 2.75rem;
      background: rgba(255, 251, 235, .28);
      text-indent: -1.65rem;
    }

    .document-body :global(em) {
      color: #60a5fa;
      font-style: italic;
    }

    .document-body :global(strong) {
      font-weight: 700;
    }

    .document-body :global(.person-name) {
      font-weight: 550;
      font-style: normal;
    }

    .document-body :global(.surname) {
      color: #9a3412;
      font-weight: 650;
    }

    .toc-return {
      position: fixed;
      right: 1.25rem;
      bottom: 1.25rem;
      z-index: 30;
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, .28);
      border-radius: .6rem;
      padding: .65rem .9rem;
      color: rgba(255, 255, 255, .9);
      background: rgba(0, 0, 0, .72);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
      font-size: .8rem;
      backdrop-filter: blur(8px);
      transition: border-color .2s, color .2s, background-color .2s;
    }

    .toc-return:hover {
      border-color: #fbbf24;
      color: #fcd34d;
      background: rgba(0, 0, 0, .86);
    }

    @media (min-width: 768px) {
      .paper-old { padding: 2.5rem; }
    }

    @media (max-width: 700px) {
      .document-body { font-size: .9rem; }
      .document-body :global(.household-entry) {
        padding: .7rem .75rem .7rem 2rem;
        text-indent: -1rem;
      }
      .toc-return { right: .75rem; bottom: .75rem; }
    }
  </style>
</LocalHistoryLayout>
