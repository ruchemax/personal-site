---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

---

<LocalHistoryLayout 
  title="Белозерье — Краеведение и генеалогия — Максим Ручкин" 
  description="Материалы по краеведению и генеалогии Белозерья: архивные документы, исторические карты и исследования."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-14">
      <a href="/ru/local_history" class="text-sm text-white/70 transition hover:text-amber-300">
        ← К разделам
      </a>
      <h1 class="mt-4 text-3xl font-bold">Белозерье</h1>

      <!-- UI section -->
      <div class="mt-6 space-y-4 text-sm text-white/90 leading-relaxed text-justify">
        <p>
          Материалы по краеведению и генеалогии Белозерья: набранные мной архивные документы и составленные на их основе карты.
        </p>
      </div>

      <div class="-ml-4 mt-4">
        <section aria-label="Материалы о Белозерье" class="space-y-0">
          <!-- UI section -->
          <a
            href="/ru/local_history/cherepovskaya-map-1677"
            class="folio-spine"
          >
            <img src="/images/local-history/folio-spine-horizontal-v2.webp" alt="" aria-hidden="true" />

            <h3 class="folio-title">
              Карта земельных владений в Череповской волости<br />
              (1677–79 гг.)
            </h3>

            <div class="folio-tags">
              <span>Белозерский уезд</span>
              <span>Надпорожский стан</span>
              <span>Череповская волость</span>
            </div>
          </a>

          <!-- UI section -->
          <a
            href="/ru/local_history/zayakoshie"
            class="folio-spine"
          >
            <img src="/images/local-history/folio-spine-horizontal-v2.webp" alt="" aria-hidden="true" />

            <h3 class="folio-title">
              Церковь Бориса и Глеба в д. Заякошье Череповской волости
            </h3>

            <div class="folio-tags">
              <span>Белозерский уезд</span>
              <span>Надпорожский стан</span>
              <span>Череповская волость</span>
              <span>д. Заякошье</span>
            </div>
          </a>

            <!-- UI section -->
            <a
              href="/ru/local_history/cherepovets-map-1626"
              class="folio-spine"
            >
              <img src="/images/local-history/folio-spine-horizontal-v2.webp" alt="" aria-hidden="true" />

              <h3 class="folio-title">
                Карта земельных владений в волости Череповец<br />
                (1626/27 г.)
              </h3>

              <div class="folio-tags">
                <span>Белозерский уезд</span>
                <span>Надпорожский стан</span>
                <span>Череповская волость</span>
              </div>
            </a>

            <!-- UI section -->
            <a
              href="/ru/local_history/churovskaya-book-1677"
              class="folio-spine"
            >
              <img src="/images/local-history/folio-spine-horizontal-v2.webp" alt="" aria-hidden="true" />

              <h3 class="folio-title">
                Перепись Чуровской волости (1677-1679 г.)
              </h3>

              <div class="folio-tags">
                <span>Белозерский уезд</span>
                <span>Надпорожский стан</span>
                <span>Чуровская волость</span>
              </div>
            </a>
        </section>
      </div>
    </div>
  </section>

  <style>
    .folio-spine {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1909 / 252;
      margin-left: 0;
      overflow: hidden;
      color: #e5bd63;
      filter: drop-shadow(0 12px 14px rgba(0, 0, 0, .5));
      transition: transform .2s ease, filter .2s ease;
    }

    .folio-spine img {
      position: absolute;
      top: 0;
      left: 50%;
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .folio-spine:hover {
      transform: translateY(-2px);
      filter: brightness(1.08) drop-shadow(0 16px 18px rgba(0, 0, 0, .58));
    }

    .folio-title {
      position: absolute;
      top: 42%;
      right: 18%;
      left: 18%;
      z-index: 1;
      margin: 0;
      color: #e5bd63;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(.78rem, 2.2vw, 1.08rem);
      font-weight: 600;
      letter-spacing: .035em;
      line-height: 1.15;
      text-align: center;
      text-shadow: 0 1px 2px #190704;
      text-orientation: mixed;
      transform: translateY(-50%);
      writing-mode: horizontal-tb;
    }

    .folio-tags {
      position: absolute;
      right: 19%;
      bottom: 28%;
      left: 19%;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .15rem .75rem;
      color: #c99b48;
      font-size: clamp(.48rem, 1.35vw, .66rem);
      text-shadow: 0 1px 2px #190704;
    }

    @media (max-width: 480px) {
      .folio-title { right: 16%; left: 16%; }
      .folio-tags { display: none; }
    }
  </style>
</LocalHistoryLayout>


