---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

const publishedAt = new Date("2026-08-24").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<LocalHistoryLayout
  title="Южный Урал — Краеведение и генеалогия — Максим Ручкин"
  description="Материалы по краеведению и генеалогии Южного Урала."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-14">
      <a href="/ru/local_history" class="text-sm text-white/70 transition hover:text-amber-300">
        ← К разделам
      </a>
      <h1 class="mt-4 text-3xl font-bold">Южный Урал</h1>

      <div class="mt-8 space-y-4">
        <a
          href="/ru/local_history/chebarkul-confession-1773"
          class="block rounded-xl border border-white/10 bg-black/40 p-4 transition hover:border-amber-400"
        >
          <div class="mb-2 text-xs text-white/60">Опубликовано: {publishedAt}</div>
          <h2 class="text-xl font-medium">
            Исповедная ведомость Преображенской церкви Чебаркульской крепости (1773 г.)
          </h2>
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Оренбургская губерния</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Исетская провинция</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Чебаркульская крепость</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</LocalHistoryLayout>
