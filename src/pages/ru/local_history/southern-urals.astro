---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

---

<LocalHistoryLayout
  title="Южный Урал — Краеведение и генеалогия — Максим Ручкин"
  description="Материалы по краеведению и генеалогии Южного Урала."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-14">
      <a href="/ru/local_history" class="text-sm text-white/70 transition hover:text-amber-300">
        ← К разделам
      </a>
      <h1 class="mt-4 text-3xl font-bold">Южный Урал</h1>

      <div class="mt-8 flex flex-wrap gap-6">
        <a
          href="/ru/local_history/chebarkul-confession-1773"
          class="folio-spine"
        >
          <img src="/images/local-history/folio-spine-horizontal-v2.webp" alt="" aria-hidden="true" />
          <h2 class="folio-title">
            Исповедная ведомость Преображенской церкви Чебаркульской крепости (1773 г.)
          </h2>
          <div class="folio-tags">
            <span>Оренбургская губерния</span>
            <span>Исетская провинция</span>
            <span>Чебаркульская крепость</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <style>
    .folio-spine {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1909 / 252;
      margin-left: 0;
      overflow: hidden;
      color: #e5bd63;
      filter: drop-shadow(0 12px 14px rgba(0, 0, 0, .5));
      transition: transform .2s ease, filter .2s ease;
    }

    .folio-spine img {
      position: absolute;
      top: 0;
      left: 50%;
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
      transform: translateX(-50%);
      pointer-events: none;
    }

    .folio-spine:hover {
      transform: translateY(-2px);
      filter: brightness(1.08) drop-shadow(0 16px 18px rgba(0, 0, 0, .58));
    }

    .folio-title {
      position: absolute;
      top: 42%;
      right: 18%;
      left: 18%;
      z-index: 1;
      margin: 0;
      color: #e5bd63;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(.78rem, 2.2vw, 1.08rem);
      font-weight: 600;
      letter-spacing: .035em;
      line-height: 1.15;
      text-align: center;
      text-shadow: 0 1px 2px #190704;
      text-orientation: mixed;
      transform: translateY(-50%);
      writing-mode: horizontal-tb;
    }

    .folio-tags {
      position: absolute;
      right: 19%;
      bottom: 28%;
      left: 19%;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: .15rem .75rem;
      color: #c99b48;
      font-size: clamp(.48rem, 1.35vw, .66rem);
      text-shadow: 0 1px 2px #190704;
    }

    @media (max-width: 480px) {
      .folio-title { right: 16%; left: 16%; }
      .folio-tags { display: none; }
    }
  </style>
</LocalHistoryLayout>
