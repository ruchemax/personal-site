---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";
import documentHtml from "../../../data/chebarkul-register-1771.html?raw";

const { lang = "ru" } = Astro.props;

const publishedAt = new Date("2026-08-31").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const headings = [...documentHtml.matchAll(/<h2 id="([^"]+)" class="document-heading">([\s\S]*?)<\/h2>/g)]
  .map(([, id, html]) => ({
    id,
    text: html.replace(/<[^>]+>/g, "").replace(/^\(л\.\s*[^)]+\)\s*/, ""),
  }))
  .filter(({ text }) =>
    ["Часть первая", "Часть вторая", "Часть третья"].some((part) => text.startsWith(part)),
  );
---

<LocalHistoryLayout
  title="Метрическая книга Преображенской церкви Чебаркульской крепости (1771 г.) — Максим Ручкин"
  description="Метрическая книга Преображенской церкви Чебаркульской крепости за 1771 год: записи о рождённых, бракосочетавшихся и умерших."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="parchment-shell mx-auto w-full max-w-[1000px] px-3 pb-12 pt-4 md:px-5">
      <div class="mb-4">
        <a href="/ru/local_history/southern-urals" class="inline-block rounded-lg border border-white/20 bg-black/30 px-4 py-2 text-sm text-white/80 hover:bg-white/10">
          ← Назад к разделу «Южный Урал»
        </a>
      </div>

      <article class="paper-old">
        <div class="relative z-10">
          <p class="mb-4 text-xs text-gray-800">Опубликовано: {publishedAt}</p>

          <h1 class="mb-2 text-2xl font-bold text-slate-800">
            Метрическая книга Преображенской церкви Чебаркульской крепости (1771 г.)
          </h1>

          <div class="mb-6 mt-3 flex flex-wrap gap-2 text-xs">
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-[#9a3412]">Оренбургская губерния</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-[#9a3412]">Исетская провинция</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-[#9a3412]">Чебаркульская крепость</span>
          </div>

          <p class="text-sm text-right italic text-slate-700">
            <a
              href="https://yandex.ru/archive/catalog/d0f4f555-40fb-4a75-84f1-69cfcffd4333/39"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#9a3412] underline"
            >
              ОГАОО. Ф. 173. Оп. 11. Д. 20. Лл. 38–41об.
            </a>
          </p>

          <div class="mt-3 space-y-3 text-sm text-slate-800 leading-relaxed mb-8 text-right">
            <p class="italic">Прочтение: М.В. Ручкин</p>
          </div>

          <div id="contents" class="mb-8 scroll-mt-20 border-b border-amber-800/30 pb-6">
            <h2 class="mb-4 text-xl font-semibold text-[#9a3412]">Содержание</h2>
            <div class="space-y-2 text-sm">
              {headings.map((heading) => (
                <div>
                  <a href={`#${heading.id}`} class="text-[#9a3412] underline">
                    {heading.text.replace(/:$/, "")}
                  </a>
                </div>
              ))}
            </div>
          </div>

          <div class="document-body text-base leading-tight" set:html={documentHtml} />

        </div>
        <span class="paper-bottom-edge" aria-hidden="true"></span>
      </article>

      <div class="mt-10">
        <a href="/ru/local_history/southern-urals" class="inline-block rounded-lg border border-white/20 bg-black/30 px-4 py-2 text-sm text-white/80 hover:bg-white/10">
          ← Назад к разделу «Южный Урал»
        </a>
      </div>
    </div>

    <a href="#contents" class="toc-return" aria-label="Вернуться к содержанию">
      ↑ К содержанию
    </a>
  </section>

  <style>
    .parchment-shell {
      container-type: inline-size;
    }

    .paper-old {
      position: relative;
      --paper-safe-left: 18%;
      --paper-safe-right: 12%;
      --paper-top-edge: 17.578125cqi;
      overflow: hidden;
      padding: 5.5rem var(--paper-safe-right) 5.5rem var(--paper-safe-left);
      border-radius: 0;
      color: #33281f;
      background-color: transparent;
      box-shadow: none;
    }

    .paper-old::before {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: var(--paper-top-edge);
      content: "";
      pointer-events: none;
      background-image: url('/images/textures/parchment-top-edge-v5.webp');
      background-position: top center;
      background-repeat: no-repeat;
      background-size: 100% 100%;
    }

    .paper-old::after {
      position: absolute;
      top: var(--paper-top-edge);
      right: 0;
      bottom: var(--paper-top-edge);
      left: 0;
      z-index: 0;
      content: "";
      pointer-events: none;
      background-image: url('/images/textures/parchment-bound-seamless-v5.webp');
      background-position: top center;
      background-repeat: no-repeat round;
      background-size: 100% auto;
    }

    .paper-bottom-edge {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 1;
      width: 100%;
      height: var(--paper-top-edge);
      pointer-events: none;
      background-image: url('/images/textures/parchment-bottom-edge-v5.webp');
      background-position: bottom center;
      background-repeat: no-repeat;
      background-size: 100% 100%;
    }

    .paper-old .text-white,
    .paper-old .text-white * {
      color: #33281f !important;
    }

    .document-body {
      max-width: 820px;
      margin-right: auto;
      margin-left: auto;
      color: #33281f;
      font-size: .9375rem;
      line-height: 1.58;
      text-align: left;
    }

    .paper-old > .relative > :not(.document-body) {
      max-width: 820px;
      margin-right: auto;
      margin-left: auto;
    }

    .document-body :global(.document-heading) {
      margin-top: 2.5rem;
      margin-bottom: 1rem;
      padding-bottom: .5rem;
      border-bottom: 1px solid rgba(146, 64, 14, .35);
      scroll-margin-top: 5rem;
      color: #9a3412;
      font-size: 1.0625rem;
      font-weight: 600;
      line-height: 1.5;
      text-align: left;
    }

    .document-body :global(.document-heading strong) {
      font-weight: 600;
    }

    .document-body :global(.document-heading em) {
      font-size: .9375rem;
      font-weight: 400;
    }

    .document-body :global(h3.document-heading) {
      position: relative;
      padding-bottom: 0;
      border-bottom: 0;
      color: #111827;
      text-align: center;
    }

    .document-body :global(h3.document-heading > em) {
      position: absolute;
      left: 0;
    }

    .document-body :global(.document-entry:first-child strong) {
      font-weight: 400;
    }

    .document-body :global(.document-entry) {
      margin-top: .5rem;
      margin-bottom: .5rem;
    }

    .document-body :global(.document-summary) {
      margin-top: 2rem;
    }

    .document-body :global(.household-entry) {
      margin-top: .1rem;
      margin-bottom: .1rem;
      padding: .8rem 1rem .8rem 2.75rem;
      text-indent: -1.65rem;
    }

    .document-body :global(em) {
      color: #2563eb;
      font-style: italic;
    }

    .document-body :global(strong) {
      font-weight: 700;
    }

    .document-body :global(.person-name) {
      font-weight: 550;
      font-style: normal;
    }

    .document-body :global(.surname) {
      color: #9a3412;
      font-weight: 600;
    }

    .toc-return {
      position: fixed;
      right: 1.25rem;
      bottom: 1.25rem;
      z-index: 30;
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, .28);
      border-radius: .6rem;
      padding: .65rem .9rem;
      color: rgba(255, 255, 255, .9);
      background: rgba(0, 0, 0, .72);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .3);
      font-size: .8rem;
      backdrop-filter: blur(8px);
      transition: border-color .2s, color .2s, background-color .2s;
    }

    .toc-return:hover {
      border-color: #fbbf24;
      color: #fcd34d;
      background: rgba(0, 0, 0, .86);
    }

    @media (max-width: 700px) {
      .paper-old {
        padding-top: 4rem;
        padding-bottom: 4rem;
      }
      .document-body { font-size: .9rem; }
      .document-body :global(.household-entry) {
        padding: .7rem .75rem .7rem 2rem;
        text-indent: -1rem;
      }
      .toc-return { right: .75rem; bottom: .75rem; }
    }
  </style>
</LocalHistoryLayout>
