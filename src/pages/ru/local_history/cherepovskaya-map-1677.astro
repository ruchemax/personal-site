  <style>
    /* Пергаментный фон как на странице карты 1626 года */
    .paper-old {
      position: relative;
      color: #2a1e14;
      padding: 2rem;
      border-radius: 0;
      overflow: hidden;

      background-color: #f3e4c9;
      background-image: url("/images/textures/old-paper.webp");
      background-size: auto;
      background-position: center;
      background-repeat: repeat;

      box-shadow:
        0 20px 40px rgba(0, 0, 0, 0.35),
        inset 0 0 140px rgba(0, 0, 0, 0.22),
        inset 0 0 24px rgba(0, 0, 0, 0.12);

      filter: saturate(1.05) contrast(1.02);
    }

    .paper-old::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: rgba(255, 255, 255, 0.6);
      mix-blend-mode: screen;
    }

    .paper-old .text-white,
    .paper-old .text-white * {
      color: #2a1e14 !important;
    }

    /* Стили для кнопки навигации внутри paper-old */
    .paper-old .mt-10 a {
      position: relative;
      z-index: 1;
      isolation: isolate;
    }

    @media (min-width: 768px) {
      .paper-old {
        padding: 2.5rem;
      }
    }

    @media (max-width: 767px) {
      .paper-old {
        padding: 1rem;
        margin: 0;
      }

      section > div {
        max-width: 100% !important;
        padding-left: 0;
        padding-right: 0;
      }
    }

    /* Стили контейнера карты */
    #frame,
    #map,
    .leaflet-container {
      border-radius: 0;
      background: transparent;
    }

    /* Делаем слой карты растянутым по всему frame (как во версии 1626 г.) */
    #map {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
    }

    #ratio {
      min-height: 50vh;
    }
  </style>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const imgUrl = "/images/maps/cherepovskaya-1677.jpg";

      const viewer = document.getElementById("viewer");
      const ratioBox = document.getElementById("ratio");
      const frame = document.getElementById("frame");
      const mapEl = document.getElementById("map");

      const btnPlus = document.getElementById("btn-zoom-in");
      const btnMinus = document.getElementById("btn-zoom-out");
      const btnReset = document.getElementById("btn-reset");
      const btnFS = document.getElementById("btn-fullscreen");
      const zoomControls = document.getElementById("zoom-controls");

      if (!viewer || !ratioBox || !frame || !mapEl) return;

      const img = new Image();
      img.src = imgUrl;

      img.onerror = () => {
        frame.innerHTML =
          '<div style="padding:1rem;color:#fca5a5;">Не удалось загрузить файл карты: ' +
          imgUrl +
          "</div>";
      };

      img.onload = () => {
        const w = img.naturalWidth;
        const h = img.naturalHeight;

        if (w && h) {
          const ratioPercent = (h / w) * 100;
          ratioBox.style.paddingTop = ratioPercent + "%";
        }

        const map = L.map(mapEl, {
          crs: L.CRS.Simple,
          zoomControl: false,
          minZoom: -5,
          maxZoom: 8,
          zoomSnap: 0,
          attributionControl: false,
        });

        const bounds = [
          [0, 0],
          [h, w],
        ];
        L.imageOverlay(imgUrl, bounds).addTo(map);
        map.fitBounds(bounds);

        // Простое управление зумом
        if (btnPlus) {
          btnPlus.addEventListener("click", () => {
            map.zoomIn();
          });
        }

        if (btnMinus) {
          btnMinus.addEventListener("click", () => {
            map.zoomOut();
          });
        }

        if (btnReset) {
          btnReset.addEventListener("click", () => {
            map.fitBounds(bounds);
          });
        }

        // Центровка кнопок зума по середине экрана в полноэкранном режиме
        const centerZoomControls = () => {
          if (!zoomControls) return;
          const rect = zoomControls.getBoundingClientRect();
          const winHeight =
            window.innerHeight || document.documentElement.clientHeight || 0;
          // Математический центр + небольшой сдвиг вниз (чтобы визуально казалось по центру)
          const targetTop = (winHeight - rect.height) / 2 + 24;

          if (document.fullscreenElement === viewer) {
            // Во fullscreen фиксируем относительно окна
            zoomControls.style.position = "fixed";
            zoomControls.style.left = "0.5rem";
            zoomControls.style.top = `${targetTop}px`;
            zoomControls.style.transform = "none";
          } else {
            // В обычном режиме возвращаемся к классам Tailwind
            zoomControls.style.position = "";
            zoomControls.style.left = "";
            zoomControls.style.top = "";
            zoomControls.style.transform = "";
          }

          // Логируем для отладки
          console.log(
            "[zoom-controls] windowTop: 0 windowBottom:",
            winHeight
          );
          console.log(
            "[zoom-controls] controls top/bottom:",
            targetTop,
            targetTop + rect.height,
            "height:",
            rect.height
          );
        };

        // Полноэкранный режим: используем стандартный Fullscreen API,
        // как в рабочем варианте страницы 1626 года.
        const toggleFullscreen = () => {
          if (!document.fullscreenElement && viewer.requestFullscreen) {
            viewer.requestFullscreen().catch((e) =>
              console.error("FS request failed:", e)
            );
          } else if (document.fullscreenElement && document.exitFullscreen) {
            document.exitFullscreen().catch((e) =>
              console.error("FS exit failed:", e)
            );
          }
        };

        btnFS?.addEventListener("click", toggleFullscreen);

        const onFsChange = () => {
          const isFs = document.fullscreenElement === viewer;
          setTimeout(() => {
            map.invalidateSize();
            map.fitBounds(bounds);
            centerZoomControls();
          }, isFs ? 80 : 40);
        };

        document.addEventListener("fullscreenchange", onFsChange);
        document.addEventListener("webkitfullscreenchange", onFsChange);
        document.addEventListener("mozfullscreenchange", onFsChange);
        document.addEventListener("MSFullscreenChange", onFsChange);
      };
    });
  </script>
