          overflow: visible;
        }
        #viewer:-webkit-full-screen #frame { 
          position: absolute; 
          inset: 0;
          width: 100%;
          height: 100%;
          overflow: visible;
        }
        #viewer:-webkit-full-screen #map { 
          overflow: visible;
        }
        #viewer:-webkit-full-screen .leaflet-container { 
          overflow: visible;
        }
        #viewer:-webkit-full-screen .mt-4 { display: none; }

      </style>

      <!-- Leaflet JS -->
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const imgUrl   = "/maps/cherepovets-1626.jpg";
          const viewer   = document.getElementById('viewer');
          const ratioBox = document.getElementById('ratio');
          const frame    = document.getElementById('frame');
          const mapEl    = document.getElementById('map');

          const btnPlus  = document.getElementById('btn-zoom-in');
          const btnMinus = document.getElementById('btn-zoom-out');
          const btnReset = document.getElementById('btn-reset');
          const btnFS    = document.getElementById('btn-fullscreen');

          const applyMapInsetsToBorder = () => {
            const cs = getComputedStyle(frame);
            const t = parseFloat(cs.borderTopWidth)    || 0;
            const r = parseFloat(cs.borderRightWidth)  || 0;
            const b = parseFloat(cs.borderBottomWidth) || 0;
            const l = parseFloat(cs.borderLeftWidth)   || 0;
            mapEl.style.top    = t + 'px';
            mapEl.style.right  = r + 'px';
            mapEl.style.bottom = b + 'px';
            mapEl.style.left   = l + 'px';
          };

          const img = new Image();
          img.src = imgUrl;

          img.onload = () => {
            const w = img.naturalWidth;
            const h = img.naturalHeight;

            const ratioPercent = (h / w) * 100;
            ratioBox.style.paddingTop = ratioPercent + '%';

            applyMapInsetsToBorder();

            const map = L.map(mapEl, {
              crs: L.CRS.Simple,
              zoomControl: false,
              minZoom: -5,
              maxZoom:  5,
              zoomSnap: 0,
              wheelPxPerZoomLevel: 120,
              attributionControl: false,
              inertia: false,
              worldCopyJump: false,
              maxBoundsViscosity: 1.0,
              // Улучшенные настройки для прокрутки
              preferCanvas: false,
              fadeAnimation: false,
              zoomAnimation: false
            });

            const bounds = [[0,0],[h,w]];
            L.imageOverlay(imgUrl, bounds).addTo(map);

            const fitExact = (isFullscreen = false) => {
              // Небольшая задержка для корректного расчета размеров
              setTimeout(() => {
                const zoom = map.getBoundsZoom(bounds, true);
                map.setView([h/2, w/2], zoom, { animate:false });
                
                // В полноэкранном режиме разрешаем прокрутку за пределы изображения
                if (isFullscreen) {
                  // Убираем ограничения границ в полноэкранном режиме
                  map.setMaxBounds(null);
                } else {
                  map.setMaxBounds(bounds);
                }
              }, 10);
            };

            fitExact();

            map.dragging.enable();
            map.scrollWheelZoom.enable();
            map.touchZoom.enable();
            map.doubleClickZoom.enable();

            btnPlus.addEventListener('click',  () => map.zoomIn());
            btnMinus.addEventListener('click', () => map.zoomOut());
            btnReset.addEventListener('click', () => {
              const isFullscreen = isFS();
              fitExact(isFullscreen);
            });

            const isFS = () => document.fullscreenElement === viewer || document.webkitFullscreenElement === viewer;
            const reqFS = () => { if (viewer.requestFullscreen) viewer.requestFullscreen(); else if (viewer.webkitRequestFullscreen) viewer.webkitRequestFullscreen(); };
            const exitFS= () => { if (document.exitFullscreen) document.exitFullscreen(); else if (document.webkitExitFullscreen) document.webkitExitFullscreen(); };

            const reflow = () => {
              applyMapInsetsToBorder();
              // Увеличиваем задержку для полноэкранного режима
              const delay = isFS() ? 100 : 10;
              const fullscreen = isFS();
              setTimeout(() => {
                map.invalidateSize({ animate:false });
                fitExact(fullscreen);
              }, delay);
            };

            // Специальная функция для переключения полноэкранного режима
            const toggleFullscreen = () => {
              if (!isFS()) {
                reqFS();
              } else {
                exitFS();
              }
            };

            btnFS.addEventListener('click', toggleFullscreen);

            // Обработка событий изменения размера и полноэкранного режима
            window.addEventListener('resize', reflow);
            document.addEventListener('fullscreenchange', reflow);
            document.addEventListener('webkitfullscreenchange', reflow);
            document.addEventListener('mozfullscreenchange', reflow);
            document.addEventListener('MSFullscreenChange', reflow);
            
            // Дополнительная обработка для корректной работы в полноэкранном режиме
            document.addEventListener('fullscreenchange', () => {
              setTimeout(() => {
                const fullscreen = isFS();
                map.invalidateSize({ animate: false });
                applyMapInsetsToBorder();
                fitExact(fullscreen);
              }, 150);
            });
            document.addEventListener('webkitfullscreenchange', () => {
              setTimeout(() => {
                const fullscreen = isFS();
                map.invalidateSize({ animate: false });
                applyMapInsetsToBorder();
                fitExact(fullscreen);
              }, 150);
            });
          };

          img.onerror = () => {
            frame.innerHTML = '<div style="padding:1rem;color:#fca5a5;">Не удалось загрузить файл карты: ' + imgUrl + '</div>';
          };
        });
      </script>

          <!-- Back navigation -->
          <div class="mt-10">
            <a href="/ru/local_history" class="inline-block rounded-lg border border-amber-800/30 bg-amber-100/50 px-4 py-2 text-sm text-slate-800 hover:bg-amber-200/50">
              ← Назад к «Краеведение»
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ---------- Пергамент «как на образце» ---------- */
    .paper-old{
      position: relative;
      color:#2a1e14;
      padding: 2rem;
      border-radius: 0;
      overflow: hidden;

      /* базовый тон */
      background-color: #f3e4c9;

      /* Паттерн из файла */
      background-image: url('/images/textures/old-paper.webp');
      background-size: auto;
      background-position: center;
      background-repeat: repeat;

      /* объём и «запылённость» */
      box-shadow:
        0 20px 40px rgba(0,0,0,.35),
        inset 0 0 140px rgba(0,0,0,.22),
        inset 0 0 24px rgba(0,0,0,.12);

      /* лёгкая коррекция тона/контраста */
      filter: saturate(1.05) contrast(1.02);
    }

    /* Светлый слой поверх паттерна для осветления */
    .paper-old::before{
      content:"";
      position:absolute; inset:0; pointer-events:none;
      background: rgba(255,255,255,0.6);
      mix-blend-mode: screen;
    }

    /* Внутри «бумаги» белый текст перекрасим в тёмный при необходимости */
    .paper-old .text-white, .paper-old .text-white * { color:#2a1e14 !important; }

    @media (min-width:768px){ .paper-old{ padding:2.5rem; } }
  </style>
</LocalHistoryLayout>
