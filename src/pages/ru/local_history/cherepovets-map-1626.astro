---
import LocalHistoryLayout from "../../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

const publishedAt = new Date("2025-09-23").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<LocalHistoryLayout title="Карта земельных владений — Максим Ручкин" lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 pt-4 pb-12">
      <!-- Весь контент на фоне бумаги -->
      <div class="paper-old shadow-2xl">
        <div class="relative z-10">
          <p class="text-xs text-gray-600 mb-4">Опубликовано: {publishedAt}</p>

          <h1 class="text-2xl font-bold mb-2 text-slate-800">Карта земельных владений в волости Череповец (1626/27 г.)</h1>

          <!-- Теги -->
          <div class="mt-3 flex flex-wrap gap-2 text-xs mb-6">
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Белозерский уезд</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Надпорожский стан</span>
            <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-700">Череповская волость</span>
          </div>

          <p class="mb-8 text-sm text-slate-800 leading-relaxed text-justify">
            Карта составлена по данным писцовой книги Белозерского уезда письма и меры Никиты Шеховского и подьячего Максима Козлова 1626/27 г.
            Копия XVIII в. за скрепой секретаря Ильи Феоктистова и справами подканцеляристов Петра Цветкова и Ивана Михайлова (РГАДА Ф.1209 Оп.1 Д.591).
          </p>

          <p class="mb-8 text-sm text-slate-800 leading-relaxed text-justify">
            Вы можете помочь с определением местоположения населённых пунктов и пустошей, существовавших в Череповской волости в 1626/27 г. 
            Ниже карты находится таблица с указанием размещённых и не размещённых на карте объектов. Если Вам известно местоположение 
            какого-то из неразмещённых объектов или Вы нашли ошибку на карте, напишите мне через 
            <a href="/ru/contacts" class="text-amber-700 hover:text-amber-800 underline">форму обратной связи</a>.
          </p>

          <!-- Карта -->
          <div class="mb-8">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

            <div id="viewer" class="relative">
              <div id="ratio" class="relative">
                    <div id="frame" class="absolute inset-0 border border-black rounded-none overflow-hidden">
                    <div id="map" class="absolute"></div>
                    
                    <!-- Zoom controls -->
                    <div class="absolute top-1/2 left-2 z-[1000] flex flex-col gap-1 -translate-y-1/2">
                      <button id="btn-zoom-in"  type="button" class="w-10 h-10 rounded-md border border-black bg-black/30 text-sm text-white/90 hover:bg-white/10 flex items-center justify-center" aria-label="Приблизить">+</button>
                      <button id="btn-zoom-out" type="button" class="w-10 h-10 rounded-md border border-black bg-black/30 text-sm text-white/90 hover:bg-white/10 flex items-center justify-center" aria-label="Отдалить">−</button>
                      <button id="btn-reset" type="button" class="w-10 h-10 rounded-md border border-black bg-black/30 text-sm text-white/90 hover:bg-white/10 flex items-center justify-center" aria-label="Сбросить масштаб">⌂</button>
                    </div>

                    <!-- Fullscreen button -->
                    <button id="btn-fullscreen" type="button"
                      class="absolute top-2 right-2 z-[1000] w-10 h-10 rounded-md border border-black bg-black/30 text-sm text-white/90 hover:bg-white/10 flex items-center justify-center"
                      title="Развернуть на весь экран" aria-label="Развернуть на весь экран">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="inline-block align-[-2px]">
                        <path d="M7 3H3v4M3 3l6 6M17 3h4v4M21 3l-6 6M7 21H3v-4M3 21l6-6M17 21h4v-4M21 21l-6-6"
                              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                </div>

              <!-- Download button -->
              <div class="mt-4 flex justify-start">
                <a href="/maps/cherepovets-1626.jpg" download="cherepovets-1626.jpg"
                   class="inline-block rounded-lg bg-amber-500/20 px-4 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-500/30">
                  Скачать карту (JPG)
                </a>
              </div>
            </div>
          </div>

          <!-- Таблица владельцев и локализации -->
          <div class="mt-8">
        
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse" style="table-layout: fixed;">
            <thead>
              <tr class="text-slate-800">
                <th class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2 text-left font-medium text-base" style="width: 25%;">Владелец</th>
                <th class="border-t-2 border-r-2 border-b border-black px-3 py-2 text-left font-medium text-base" style="width: 40%;">Размещённые</th>
                <th class="border-t-2 border-r-2 border-b border-black px-3 py-2 text-left font-medium text-base" style="width: 35%;">Неразмещённые</th>
              </tr>
            </thead>
            <tbody>
              <!-- Заголовок волости -->
              <tr class="bg-white/5">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2 text-base font-medium" colspan="3"><span class="text-gray-400 italic font-normal">(л. 149)</span> Волость Череповец, а в ней за разными помещики</td>
              </tr>
              
              <!-- Первая группа - Полукет Елизарьев сын Теметцкой -->
              <tr class="bg-white/5 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="6">№78 За Полуектом Елизарьевым сыном Теметцким</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">деревня Урывково, а в ней двор помещиков</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">пустошь Ившино</td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня Макарьино</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Паршино</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Пулово</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь, что был починок Деревятин</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">пустошь, что был починок Дорогин</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Вторая группа - Алексей Михайлов сын Панфилов -->
              <tr class="bg-white/5 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="7">№79 За Алексеем Михайловым сыном Панфилова</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">отца ево поместье полпустоши, что была деревня Рождественская на реке на Шексне а другая половина той пустоши в церковной земле</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня Кононовская пуста</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня Негодяево пуста</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня Фроловская, а в ней двор помещиков</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">полдеревни Киргады, а другая половина той деревни за Юрием Оксентьевым</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Горка</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">пустошь Медвежей Бор</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Третья группа - Матвей Константинов сын Поливанов -->
              <tr class="bg-white/10 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="9">№80 За Матвеем Константиновым сыном Поливанова</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">что он выменил у Федора Семенова сына Козлова, деревня Алексеевская пуста</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">пустошь Осюнинская</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня, что было село Захарьевская пуста</td>
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Белково</td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">деревня Курилова пуста</td>
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Губинская</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">полдеревни Парфенова, а другая половина той деревни за Хотеном Худошиным</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">в Турховской кулиге деревня Климовская, а в ней два двора помещикова</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">полселца Федоровскаго пустошь, а другая половина того селца за Григорьем Булгаковым</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Старина Петроклинская тож</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border-r-2 border-b border-black px-3 py-2">пустошь Микитинская</td>
                <td class="border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">пустошь что была деревня Петракова</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Четвертая группа - Хотен Васильев сын Худошин -->
              <tr class="bg-white/5 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="8">№81 За Хотеном Васильевым сыном Худошина</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">что он выменил у Романа Иванова сына Решетова, полселца Дуракова, а другая половина того селца за Иваном Косецким</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">селцо Коровинское, Маленкинское тож, а в нем два двора помещиковы</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">деревня Парфеновы Горы пуста, а другая половина той деревни за Матфеем Поливановым</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">полпустоши Заякошье, а другая половина той пустоши церковная земля</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Веретея</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Давыдовская</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Лукинская</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Афонинская</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Пятая группа - Иван Дмитриев сын Косецкий -->
              <tr class="bg-white/10">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="6">№82 За Иваном Дмитревым сыном Косецким</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">полселца Дуракова</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">пустошь Бурлукин</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">деревня Гритино Болшое пуста</td>
                <td class="border border-r-2 border-black px-3 py-2">пустошь, что был починок Москва</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">деревня Гритино Меншое пуста</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">два жеребья селца Никольскаго, а третей жеребей того селца за Тимофеем Масловым, а в нем на ивановы жеребьи двор помещиков </td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Раменка</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">пустошь, что был починок Воробьев</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Шестая группа - Андрей Пантелеев сын Екушкин -->
              <tr class="bg-white/10">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="5">№83 За Андреем Пантелеевым сыном Екушкина</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">что было наперед того за Иваном Кузминым сыном Орловым, деревня Баскова а Баскакова тож пуста</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">пустошь Шевырево</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Ванютино</td>
                <td class="border border-r-2 border-black px-3 py-2">пустошь что был починок Кутузов</td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">село Борисово на реке на Шексне, а в селе на государеве земле церковь Преображения Спасова</td>
                <td class="border border-r-2 border-black px-3 py-2">пустошь Федякино</td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">деревня Лапач</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">деревня Цылинская на реке на Шексне, а в ней двор помещиков</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Седьмая группа - Федор Дмитриев сын Косецкий -->
              <tr class="bg-white/5 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="2">№84 За Федором Дмитриевым сыном Косецким</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">что было наперед того за Перфильем Васильевым сыном Волженским, две трети деревни Новоселки пусто а треть той же деревни за Ондреем Макаровым</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">пустошь Федюнино</td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border-r-2 border-b-2 border-black px-3 py-2">деревня Юрьева пуста</td>
                <td class="border-r-2 border-b-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Восьмая группа - Иван Иванов сын Юрлов -->
              <tr class="bg-white/5 owner-group">
                <td class="border-l-2 border-t-2 border-r-2 border-b border-black px-3 py-2" rowspan="3">№85 За Иваном Ивановым сыном Юрловым</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">что была наперед того за дядею ево за Олексеем Михайловым сыном Юрлова деревня Полуева</td>
                <td class="border-t-2 border-r-2 border-b border-black px-3 py-2">полпустоши, что был починок Югин, а другая половина той пустоши за Тимофеем Масловым</td>
              </tr>
              <tr class="bg-white/10 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">полдеревни Цыкова, а другая половина той деревни за Тимофеем Масловым</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>
              <tr class="bg-white/5 owner-group">
                <td class="border border-r-2 border-black px-3 py-2">пустошь Болсунова</td>
                <td class="border border-r-2 border-black px-3 py-2"></td>
              </tr>

              <!-- Девятая группа - Федор Семенов сын Козлов -->
              <tr class="bg-white/5 owner-group">
