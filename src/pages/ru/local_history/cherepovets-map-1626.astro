          overflow: visible;
        }
        #viewer:-webkit-full-screen #frame { 
          position: absolute; 
          inset: 0;
          width: 100%;
          height: 100%;
          overflow: visible;
        }
        #viewer:-webkit-full-screen #map { 
          overflow: visible;
        }
        #viewer:-webkit-full-screen .leaflet-container { 
          overflow: visible;
        }
        #viewer:-webkit-full-screen .mt-4 { display: none; }

      </style>

      <!-- Leaflet JS -->
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          // -----------------------
          // Элементы/конфиг
          // -----------------------
          const imgUrl   = "/images/maps/cherepovets-1626.jpg";
          const viewer   = document.getElementById('viewer');
          const ratioBox = document.getElementById('ratio');
          const frame    = document.getElementById('frame');
          const mapEl    = document.getElementById('map');

          const btnPlus  = document.getElementById('btn-zoom-in');
          const btnMinus = document.getElementById('btn-zoom-out');
          const btnReset = document.getElementById('btn-reset');
          const btnFS    = document.getElementById('btn-fullscreen');

          // -----------------------
          // Хелперы
          // -----------------------
          const debounce = (fn, wait = 120) => {
            let t;
            return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), wait); };
          };

          const getViewportHeight = () => {
            if (window.visualViewport && typeof window.visualViewport.height === 'number') {
              return Math.round(window.visualViewport.height);
            }
            return Math.round(window.innerHeight || document.documentElement.clientHeight || screen.height);
          };

          const isMobile = () => {
            return /iPhone|iPad|iPod|Android|webOS|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ||
                   (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) ||
                   (window.innerWidth <= 768);
          };

          const applyMapInsetsToBorder = () => {
            if (!frame || !mapEl) return;
            // В полноэкранном режиме на мобильном не применяем insets от границ
            if (viewer && viewer.classList.contains('fullscreen-mobile') && isMobile()) {
              mapEl.style.top = '0';
              mapEl.style.right = '0';
              mapEl.style.bottom = '0';
              mapEl.style.left = '0';
              return;
            }
            const cs = getComputedStyle(frame);
            const t = parseFloat(cs.borderTopWidth)    || 0;
            const r = parseFloat(cs.borderRightWidth)  || 0;
            const b = parseFloat(cs.borderBottomWidth) || 0;
            const l = parseFloat(cs.borderLeftWidth)   || 0;
            mapEl.style.top    = t + 'px';
            mapEl.style.right  = r + 'px';
            mapEl.style.bottom = b + 'px';
            mapEl.style.left   = l + 'px';
          };

          // -----------------------
          // Загрузка изображения (чтобы взять ratio)
          // -----------------------
          const img = new Image();
          img.src = imgUrl;

          img.onerror = () => {
            if (frame) {
              frame.innerHTML = '<div style="padding:1rem;color:#fca5a5;">Не удалось загрузить файл карты: ' + imgUrl + '</div>';
            }
          };

          img.onload = () => {
            const w = img.naturalWidth;
            const h = img.naturalHeight;
            const ratioPercent = (h / w) * 100;

            if (ratioBox) {
              ratioBox.style.paddingTop = ratioPercent + '%';
            }
            applyMapInsetsToBorder();

            // -----------------------
            // Инициализация Leaflet
            // -----------------------
            const map = L.map(mapEl, {
              crs: L.CRS.Simple,
              zoomControl: false,
              minZoom: -5,
              maxZoom:  8,
              zoomSnap: 0,
              wheelPxPerZoomLevel: 120,
              attributionControl: false,
              inertia: false,
              worldCopyJump: false,
              maxBoundsViscosity: 1.0,
              preferCanvas: false,
              fadeAnimation: false,
              zoomAnimation: false
            });

            const bounds = [[0,0],[h,w]];
            L.imageOverlay(imgUrl, bounds).addTo(map);

            // -----------------------
            // Функция: принудительное вписывание по высоте
            // -----------------------
            async function fitPreferHeight(mapInstance, boundsObj) {
              if (!mapInstance) return;
              // Базовый fit
              mapInstance.fitBounds(boundsObj, { animate: false, padding: [0, 0] });
              // Ждём рендера
              await new Promise(requestAnimationFrame);
              mapInstance.invalidateSize(false);
              await new Promise(resolve => setTimeout(resolve, 30));

              const container = mapInstance.getContainer();
              const imgLayerEl = container.querySelector('.leaflet-image-layer');
              if (!imgLayerEl) return;

              const containerH = container.clientHeight;
              const imgH = imgLayerEl.offsetHeight;

              // Если уже занимает по высоте — ничего не делаем
              if (imgH >= containerH - 1) return;

              // Нужно увеличить zoom так, чтобы imgH * scale >= containerH
              const neededScale = containerH / Math.max(imgH, 1);
              const deltaZoom = Math.log2(neededScale);
              const curZoom = mapInstance.getZoom();
              let targetZoom = curZoom + deltaZoom;

              // Ограничения
              const minZ = mapInstance.getMinZoom();
              const maxZ = mapInstance.getMaxZoom();
              if (targetZoom > maxZ) targetZoom = maxZ;
              if (targetZoom < minZ) targetZoom = minZ;

              mapInstance.setZoom(targetZoom, { animate: false });

              // Финальный invalidate
              requestAnimationFrame(() => mapInstance.invalidateSize(false));
            }

            // -----------------------
            // Управление размерами контейнеров в fullscreen (мобильный)
            // -----------------------
            const setFullscreenPixelSizes = (vhPx) => {
              // КРИТИЧНО: Сначала устанавливаем правильные размеры для viewer
              // Используем setProperty с important, чтобы переопределить CSS стили
              if (viewer) {
                viewer.style.setProperty('position', 'fixed', 'important');
                viewer.style.setProperty('top', '0', 'important');
                viewer.style.setProperty('left', '0', 'important');
                viewer.style.setProperty('right', '0', 'important');
                viewer.style.setProperty('bottom', '0', 'important');
                viewer.style.setProperty('width', '100vw', 'important');
                viewer.style.setProperty('height', vhPx + 'px', 'important');
                viewer.style.setProperty('min-height', vhPx + 'px', 'important');
                viewer.style.setProperty('max-height', vhPx + 'px', 'important');
                viewer.style.setProperty('margin', '0', 'important');
                viewer.style.setProperty('padding', '0', 'important');
                viewer.style.setProperty('overflow', 'hidden', 'important');
                viewer.style.setProperty('z-index', '999999', 'important');
                viewer.style.setProperty('transform', 'none', 'important');
              }
              
              // Используем width:100vw для полноэкранного режима
              if (ratioBox) {
                ratioBox.style.paddingTop = '0';
                ratioBox.style.width = '100vw';
                ratioBox.style.height = vhPx + 'px';
                ratioBox.style.minHeight = vhPx + 'px';
                ratioBox.style.maxHeight = vhPx + 'px';
                ratioBox.style.position = 'absolute';
                ratioBox.style.top = '0';
                ratioBox.style.left = '0';
                ratioBox.style.right = '0';
                ratioBox.style.bottom = '0';
                ratioBox.style.margin = '0';
                ratioBox.style.padding = '0';
                ratioBox.style.transform = 'none';
              }
              if (frame) {
                frame.style.width  = '100vw';
                frame.style.height = vhPx + 'px';
                frame.style.minHeight = vhPx + 'px';
                frame.style.maxHeight = vhPx + 'px';
                frame.style.position = 'absolute';
                frame.style.top = '0';
                frame.style.left = '0';
                frame.style.right = '0';
                frame.style.bottom = '0';
                frame.style.margin = '0';
                frame.style.transform = 'none';
              }
              if (mapEl) {
                mapEl.style.width  = '100vw';
                mapEl.style.height = vhPx + 'px';
                mapEl.style.minHeight = vhPx + 'px';
                mapEl.style.maxHeight = vhPx + 'px';
                mapEl.style.position = 'absolute';
                mapEl.style.top = '0';
                mapEl.style.left = '0';
                mapEl.style.right = '0';
                mapEl.style.bottom = '0';
                mapEl.style.margin = '0';
                mapEl.style.transform = 'none';
                mapEl.style.inset = '0';
              }
              
              // Убеждаемся, что Leaflet контейнер также имеет правильные размеры
              if (mapEl) {
                const leafletContainer = mapEl;
                if (leafletContainer) {
                  leafletContainer.style.width = '100vw';
                  leafletContainer.style.height = vhPx + 'px';
                  leafletContainer.style.minHeight = vhPx + 'px';
                  leafletContainer.style.maxHeight = vhPx + 'px';
                }
              }
              
              // Логирование после setFullscreenPixelSizes
              if (mapEl) {
                const rect = mapEl.getBoundingClientRect();
                const mapComputed = window.getComputedStyle(mapEl);
                console.log('[Step 1] After setFullscreenPixelSizes: mapEl.bottom = ' + rect.bottom + 'px (target: ' + vhPx + 'px)');
                console.log('[Step 1] mapEl.style.height = ' + mapEl.style.height + ', mapEl.style.top = ' + mapEl.style.top);
                console.log('[Step 1] mapEl computed: height = ' + mapComputed.height + ', top = ' + mapComputed.top + ', transform = ' + mapComputed.transform);
                console.log('[Step 1] mapEl.getBoundingClientRect(): top = ' + rect.top + ', bottom = ' + rect.bottom + ', height = ' + rect.height);
                
                // Проверяем родительские элементы
                if (frame) {
                  const frameRect = frame.getBoundingClientRect();
                  const frameComputed = window.getComputedStyle(frame);
                  console.log('[Step 1] frame: top = ' + frameRect.top + ', bottom = ' + frameRect.bottom + ', height = ' + frameRect.height);
                  console.log('[Step 1] frame computed: height = ' + frameComputed.height + ', top = ' + frameComputed.top);
                  console.log('[Step 1] frame.style.height = ' + frame.style.height + ', frame.style.top = ' + frame.style.top);
                }
                if (ratioBox) {
                  const ratioRect = ratioBox.getBoundingClientRect();
                  const ratioComputed = window.getComputedStyle(ratioBox);
                  console.log('[Step 1] ratioBox: top = ' + ratioRect.top + ', bottom = ' + ratioRect.bottom + ', height = ' + ratioRect.height);
                  console.log('[Step 1] ratioBox computed: height = ' + ratioComputed.height + ', top = ' + ratioComputed.top);
                  console.log('[Step 1] ratioBox.style.height = ' + ratioBox.style.height + ', ratioBox.style.top = ' + ratioBox.style.top);
                }
                if (viewer) {
                  const viewerRect = viewer.getBoundingClientRect();
                  const viewerComputed = window.getComputedStyle(viewer);
                  console.log('[Step 1] viewer: top = ' + viewerRect.top + ', bottom = ' + viewerRect.bottom + ', height = ' + viewerRect.height);
                  console.log('[Step 1] viewer computed: height = ' + viewerComputed.height + ', top = ' + viewerComputed.top);
                }
              }
            };

            const restoreRatioMode = () => {
              const ratioPercentLocal = (img.naturalHeight / img.naturalWidth) * 100;
              if (ratioBox) {
                ratioBox.style.paddingTop = ratioPercentLocal + '%';
                ratioBox.style.height = '';
                ratioBox.style.width = '';
                ratioBox.style.position = '';
              }
              if (frame) {
                frame.style.width = '';
                frame.style.height = '';
              }
              if (mapEl) {
                mapEl.style.width = '';
                mapEl.style.height = '';
              }
            };

            // -----------------------
            // Fit initial
            // -----------------------
            const initialFit = () => {
              requestAnimationFrame(() => {
                map.invalidateSize(false);
                map.fitBounds(bounds, { animate: false, padding: [0, 0] });
              });
            };
            initialFit();

            // -----------------------
            // Кнопки и fullscreen
            // -----------------------
            map.dragging.enable();
            map.scrollWheelZoom.enable();
            map.touchZoom.enable();
            map.doubleClickZoom.enable();

            btnPlus?.addEventListener('click',  () => map.zoomIn());
            btnMinus?.addEventListener('click', () => map.zoomOut());

            btnReset?.addEventListener('click', () => {
              if (viewer.classList.contains('fullscreen-mobile') && isMobile()) {
                fitPreferHeight(map, bounds);
              } else {
                map.fitBounds(bounds, { animate: false, padding: [0, 0] });
              }
            });

            const enterMobileFs = () => {
              // КРИТИЧНО: Сначала сбрасываем scroll СИНХРОННО, чтобы не было смещения
              // Используем behavior: 'instant' для немедленного сброса
              window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
              document.documentElement.scrollTop = 0;
              document.documentElement.scrollLeft = 0;
              document.body.scrollTop = 0;
              document.body.scrollLeft = 0;
              
              // Принудительно блокируем прокрутку
              document.documentElement.style.overflow = 'hidden';
              document.body.style.overflow = 'hidden';
              
              // Небольшая задержка чтобы убедиться, что scroll сброшен
              requestAnimationFrame(() => {
                window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
                document.documentElement.scrollTop = 0;
                document.body.scrollTop = 0;
                
                viewer.classList.add('fullscreen-mobile');
                document.body.classList.add('fullscreen-mobile-active');
                document.documentElement.classList.add('fullscreen-mobile-active');
                
                enterMobileFsContinue();
              });
            };
            
            const enterMobileFsContinue = () => {

              const header = document.querySelector('header');
              const footer = document.querySelector('footer');
              if (header) { header.dataset.fullscreenHidden = 'true'; header.style.display = 'none'; }
              if (footer) { footer.dataset.fullscreenHidden = 'true'; footer.style.display = 'none'; }

              // КРИТИЧНО: Убираем отступы у body и html в полноэкранном режиме
              const body = document.body;
              const html = document.documentElement;
              
              // Сохраняем оригинальные стили для восстановления
              if (!body.dataset.originalBodyStyle) {
                body.dataset.originalBodyStyle = JSON.stringify({
                  margin: body.style.margin,
                  padding: body.style.padding,
                  overflow: body.style.overflow
                });
              }
              if (!html.dataset.originalHtmlStyle) {
                html.dataset.originalHtmlStyle = JSON.stringify({
                  margin: html.style.margin,
                  padding: html.style.padding,
                  overflow: html.style.overflow
                });
              }
              
              body.style.margin = '0';
              body.style.padding = '0';
              body.style.overflow = 'hidden';
              html.style.margin = '0';
              html.style.padding = '0';
              html.style.overflow = 'hidden';

              // Еще раз сбрасываем scroll перед установкой стилей
              window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
              document.documentElement.scrollTop = 0;
              document.body.scrollTop = 0;

              const vh = getViewportHeight();
              
              // КРИТИЧНО: Устанавливаем правильные размеры для viewer ПЕРЕД setFullscreenPixelSizes
              // Используем setProperty с important, чтобы переопределить CSS стили
              if (viewer) {
                viewer.style.setProperty('position', 'fixed', 'important');
                viewer.style.setProperty('top', '0', 'important');
                viewer.style.setProperty('left', '0', 'important');
                viewer.style.setProperty('right', '0', 'important');
                viewer.style.setProperty('bottom', '0', 'important');
                viewer.style.setProperty('width', '100vw', 'important');
                viewer.style.setProperty('height', vh + 'px', 'important');
                viewer.style.setProperty('min-height', vh + 'px', 'important');
                viewer.style.setProperty('max-height', vh + 'px', 'important');
                viewer.style.setProperty('margin', '0', 'important');
                viewer.style.setProperty('padding', '0', 'important');
                viewer.style.setProperty('z-index', '999999', 'important');
                viewer.style.setProperty('transform', 'none', 'important');
                viewer.style.setProperty('overflow', 'hidden', 'important');
              }
              
              setFullscreenPixelSizes(vh);

              requestAnimationFrame(() => {
                // Сначала убеждаемся, что размеры установлены правильно
                const currentVh = getViewportHeight();
                console.log('[Enter Fullscreen] Step 0: Viewport height = ' + currentVh + 'px');
                
                // КРИТИЧНО: Еще раз убеждаемся, что viewer имеет правильные размеры
                // Используем setProperty с important, чтобы переопределить CSS стили
                if (viewer) {
                  // Проверяем и исправляем родительские элементы
                  let parent = viewer.parentElement;
                  let parentLevel = 0;
                  while (parent && parentLevel < 5) {
                    const parentRect = parent.getBoundingClientRect();
                    const parentComputed = window.getComputedStyle(parent);
                    console.log('[Step 0.5] Parent level ' + parentLevel + ' (' + parent.tagName + '): top = ' + parentRect.top + ', transform = ' + parentComputed.transform);
                    console.log('[Step 0.5] Parent level ' + parentLevel + ' computed: margin = ' + parentComputed.margin + ', padding = ' + parentComputed.padding);
                    console.log('[Step 0.5] Parent level ' + parentLevel + ' computed: margin-top = ' + parentComputed.marginTop + ', padding-top = ' + parentComputed.paddingTop);
                    
                    // Убираем transform у родительских элементов, если он есть
                    if (parentComputed.transform && parentComputed.transform !== 'none') {
                      parent.style.setProperty('transform', 'none', 'important');
                      console.log('[Step 0.5] Removed transform from parent level ' + parentLevel);
                    }
                    
                    // КРИТИЧНО: Убираем padding-top и margin-top у ВСЕХ родительских элементов в полноэкранном режиме
                    // Даже если top = 0, padding-top может влиять на позиционирование дочерних элементов
                    const parentPaddingTop = parseFloat(parentComputed.paddingTop) || 0;
                    const parentMarginTop = parseFloat(parentComputed.marginTop) || 0;
                    
                    if (parentPaddingTop > 0 || parentMarginTop > 0 || parentRect.top !== 0) {
                      parent.style.setProperty('margin-top', '0', 'important');
                      parent.style.setProperty('padding-top', '0', 'important');
                      parent.style.setProperty('margin', '0', 'important');
                      parent.style.setProperty('padding', '0', 'important');
                      console.log('[Step 0.5] Removed margin/padding from parent level ' + parentLevel + ' (padding-top was ' + parentPaddingTop + 'px, margin-top was ' + parentMarginTop + 'px, top was ' + parentRect.top + ')');
                    }
                    
                    parent = parent.parentElement;
                    parentLevel++;
                  }
                  
                  // Проверяем scroll position
                  console.log('[Step 0.5] window.scrollY = ' + window.scrollY + ', window.scrollX = ' + window.scrollX);
                  console.log('[Step 0.5] document.documentElement.scrollTop = ' + document.documentElement.scrollTop);
                  
                  // Устанавливаем scroll на 0
                  window.scrollTo(0, 0);
                  document.documentElement.scrollTop = 0;
                  document.body.scrollTop = 0;
                  
                  viewer.style.setProperty('position', 'fixed', 'important');
                  viewer.style.setProperty('top', '0', 'important');
                  viewer.style.setProperty('left', '0', 'important');
                  viewer.style.setProperty('right', '0', 'important');
                  viewer.style.setProperty('bottom', '0', 'important');
                  viewer.style.setProperty('width', '100vw', 'important');
                  viewer.style.setProperty('height', currentVh + 'px', 'important');
                  viewer.style.setProperty('min-height', currentVh + 'px', 'important');
                  viewer.style.setProperty('max-height', currentVh + 'px', 'important');
                  viewer.style.setProperty('margin', '0', 'important');
                  viewer.style.setProperty('padding', '0', 'important');
                  viewer.style.setProperty('overflow', 'hidden', 'important');
                  viewer.style.setProperty('transform', 'none', 'important');
                  viewer.style.setProperty('will-change', 'auto', 'important');
                  
                  // КРИТИЧНО: Проверяем и компенсируем смещение viewer
                  const viewerRect = viewer.getBoundingClientRect();
                  const offsetTop = viewerRect.top;
                  const offsetBottom = viewerRect.bottom;
                  
                  if (offsetTop !== 0 || offsetBottom !== currentVh) {
                    console.log('[Step 0.5] viewer is offset by ' + offsetTop + 'px, compensating');
                    // Компенсируем смещение, используя отрицательный top
                    const compensatedTop = -offsetTop;
                    viewer.style.setProperty('top', compensatedTop + 'px', 'important');
                    // Также компенсируем высоту, чтобы bottom совпадал с viewport bottom
                    const targetBottom = currentVh;
                    const currentHeight = viewerRect.height;
                    const heightAdjustment = targetBottom - offsetBottom;
                    if (heightAdjustment !== 0) {
                      const newHeight = currentHeight + heightAdjustment;
                      viewer.style.setProperty('height', newHeight + 'px', 'important');
                      viewer.style.setProperty('min-height', newHeight + 'px', 'important');
                      viewer.style.setProperty('max-height', newHeight + 'px', 'important');
                    }
                  }
                  
                  console.log('[Step 0.5] After setting viewer styles: viewer.style.height = ' + viewer.style.height);
                  const finalViewer = document.getElementById('viewer');
                  const finalViewerRect = finalViewer ? finalViewer.getBoundingClientRect() : viewer.getBoundingClientRect();
                  console.log('[Step 0.5] viewer.getBoundingClientRect(): top = ' + finalViewerRect.top + ', bottom = ' + finalViewerRect.bottom + ', height = ' + finalViewerRect.height);
                  const finalComputed = finalViewer ? window.getComputedStyle(finalViewer) : window.getComputedStyle(viewer);
                  console.log('[Step 0.5] viewer computed: height = ' + finalComputed.height + ', top = ' + finalComputed.top + ', transform = ' + finalComputed.transform);
                }
                
                // Еще раз проверяем и убираем padding у родительских элементов после небольшой задержки
                // чтобы убедиться, что изменения применились
                requestAnimationFrame(() => {
                  let parent = viewer.parentElement;
                  let parentLevel = 0;
                  while (parent && parentLevel < 5) {
                    parent.style.setProperty('margin', '0', 'important');
                    parent.style.setProperty('padding', '0', 'important');
                    parent.style.setProperty('margin-top', '0', 'important');
                    parent.style.setProperty('padding-top', '0', 'important');
                    parent = parent.parentElement;
                    parentLevel++;
                  }
                });
                
                setFullscreenPixelSizes(currentVh);
                
                // КРИТИЧНО: Применяем стили к контейнеру с кнопками зума
                // Находим кнопку зума и поднимаемся к её родителю (контейнеру)
                const btnZoomIn = document.getElementById('btn-zoom-in');
                const zoomControlsContainer = btnZoomIn?.parentElement;
                if (zoomControlsContainer && frame?.contains(zoomControlsContainer)) {
                  console.log('[Step 1.5] Found zoom controls container');
                  
                  // КРИТИЧНО: Сначала устанавливаем размеры и видимость для кнопок
                  const buttons = zoomControlsContainer.querySelectorAll('button');
                  buttons.forEach((btn, idx) => {
                    btn.style.setProperty('z-index', '10000001', 'important');
                    btn.style.setProperty('display', 'flex', 'important');
                    btn.style.setProperty('visibility', 'visible', 'important');
                    btn.style.setProperty('opacity', '1', 'important');
                    btn.style.setProperty('width', '2.5rem', 'important');
                    btn.style.setProperty('height', '2.5rem', 'important');
                    btn.style.setProperty('min-width', '2.5rem', 'important');
                    btn.style.setProperty('min-height', '2.5rem', 'important');
                    btn.style.setProperty('position', 'relative', 'important');
                    console.log('[Step 1.5] Button ' + idx + ' (' + btn.id + '): visible, size = ' + btn.offsetWidth + 'x' + btn.offsetHeight);
                  });
                  
                  // Затем устанавливаем стили для контейнера
                  zoomControlsContainer.style.setProperty('z-index', '10000000', 'important');
                  zoomControlsContainer.style.setProperty('display', 'flex', 'important');
                  zoomControlsContainer.style.setProperty('flex-direction', 'column', 'important');
                  zoomControlsContainer.style.setProperty('visibility', 'visible', 'important');
                  zoomControlsContainer.style.setProperty('opacity', '1', 'important');
                  zoomControlsContainer.style.setProperty('pointer-events', 'auto', 'important');
                  zoomControlsContainer.style.setProperty('position', 'absolute', 'important');
                  zoomControlsContainer.style.setProperty('left', '0.5rem', 'important');
                  zoomControlsContainer.style.setProperty('top', '50%', 'important');
                  zoomControlsContainer.style.setProperty('transform', 'translateY(-50%)', 'important');
                  zoomControlsContainer.style.setProperty('gap', '0.25rem', 'important');
                  zoomControlsContainer.style.setProperty('background', 'transparent', 'important');
                  zoomControlsContainer.style.setProperty('width', 'auto', 'important');
