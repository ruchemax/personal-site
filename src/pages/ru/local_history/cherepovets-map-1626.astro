                  zoomControlsContainer.style.setProperty('margin', '0', 'important');
                  zoomControlsContainer.style.setProperty('padding', '0', 'important');
                  
                  // Ждем рендера и проверяем размеры
                  requestAnimationFrame(() => {
                    const rect = zoomControlsContainer.getBoundingClientRect();
                    console.log('[Step 1.5] Zoom controls container after RAF: top = ' + rect.top + ', left = ' + rect.left + ', width = ' + rect.width + ', height = ' + rect.height);
                    console.log('[Step 1.5] Container computed style: display = ' + window.getComputedStyle(zoomControlsContainer).display + ', visibility = ' + window.getComputedStyle(zoomControlsContainer).visibility);
                    
                    // Проверяем размеры кнопок еще раз
                    buttons.forEach((btn, idx) => {
                      const btnRect = btn.getBoundingClientRect();
                      console.log('[Step 1.5] Button ' + idx + ' (' + btn.id + ') after RAF: top = ' + btnRect.top + ', left = ' + btnRect.left + ', width = ' + btnRect.width + ', height = ' + btnRect.height);
                    });
                  });
                } else {
                  console.log('[Step 1.5] Zoom controls container not found! btnZoomIn = ' + btnZoomIn + ', parent = ' + zoomControlsContainer);
                }
                
                // Затем применяем границы и подгоняем карту
                if (mapEl) {
                  const rect = mapEl.getBoundingClientRect();
                  console.log('[Step 2] After setFullscreenPixelSizes, before applyMapInsetsToBorder: mapEl.bottom = ' + rect.bottom + 'px');
                }
                
              applyMapInsetsToBorder();
                if (mapEl) {
                  const rect = mapEl.getBoundingClientRect();
                  console.log('[Step 3] After applyMapInsetsToBorder: mapEl.bottom = ' + rect.bottom + 'px');
                  console.log('[Step 3] mapEl.style.top = ' + mapEl.style.top + ', mapEl.style.bottom = ' + mapEl.style.bottom);
                }
                
                map.invalidateSize(false);
                if (mapEl) {
                  const rect = mapEl.getBoundingClientRect();
                  console.log('[Step 4] After invalidateSize: mapEl.bottom = ' + rect.bottom + 'px');
                }
                
                fitPreferHeight(map, bounds);
                if (mapEl) {
                  const rect = mapEl.getBoundingClientRect();
                  console.log('[Step 5] After fitPreferHeight: mapEl.bottom = ' + rect.bottom + 'px');
                }
                
                // Логирование координат после входа в полноэкранный режим
              setTimeout(() => {
                  // Еще раз обновляем размеры, если viewport изменился
                  const finalVh = getViewportHeight();
                  console.log('[Step 6] In setTimeout: finalVh = ' + finalVh + 'px');
                  if (mapEl) {
                    const rect = mapEl.getBoundingClientRect();
                    console.log('[Step 6] Before setFullscreenPixelSizes in setTimeout: mapEl.bottom = ' + rect.bottom + 'px');
                  }
                  
                  setFullscreenPixelSizes(finalVh);
                  
                  if (mapEl) {
                    const rect = mapEl.getBoundingClientRect();
                    console.log('[Step 7] After setFullscreenPixelSizes in setTimeout: mapEl.bottom = ' + rect.bottom + 'px');
                  }
                  
                  // ФОРСИРУЕМ правильное позиционирование после всех операций
                  if (ratioBox) {
                    ratioBox.style.top = '0';
                    ratioBox.style.left = '0';
                    ratioBox.style.right = '0';
                    ratioBox.style.bottom = '0';
                    ratioBox.style.position = 'absolute';
                    ratioBox.style.height = finalVh + 'px';
                    ratioBox.style.minHeight = finalVh + 'px';
                    ratioBox.style.maxHeight = finalVh + 'px';
                  }
                  if (frame) {
                    frame.style.top = '0';
                    frame.style.left = '0';
                    frame.style.right = '0';
                    frame.style.bottom = '0';
                    frame.style.position = 'absolute';
                    frame.style.height = finalVh + 'px';
                    frame.style.minHeight = finalVh + 'px';
                    frame.style.maxHeight = finalVh + 'px';
                  }
                  if (mapEl) {
                    mapEl.style.top = '0';
                    mapEl.style.left = '0';
                    mapEl.style.right = '0';
                    mapEl.style.bottom = '0';
                    mapEl.style.position = 'absolute';
                    mapEl.style.height = finalVh + 'px';
                    mapEl.style.minHeight = finalVh + 'px';
                    mapEl.style.maxHeight = finalVh + 'px';
                    mapEl.style.margin = '0';
                    mapEl.style.transform = 'none';
                    
                    const rect = mapEl.getBoundingClientRect();
                    console.log('[Step 8] After forcing styles: mapEl.bottom = ' + rect.bottom + 'px');
                    console.log('[Step 8] mapEl.style.height = ' + mapEl.style.height + ', mapEl.style.top = ' + mapEl.style.top);
                  }
                  
                  map.invalidateSize(false);
                  
                  // КРИТИЧНО: Снова применяем стили к контейнеру с кнопками после invalidateSize
                  const btnZoomInAgain = document.getElementById('btn-zoom-in');
                  const zoomControlsContainerAgain = btnZoomInAgain?.parentElement;
                  if (zoomControlsContainerAgain && frame?.contains(zoomControlsContainerAgain)) {
                    const buttonsAgain = zoomControlsContainerAgain.querySelectorAll('button');
                    buttonsAgain.forEach((btn) => {
                      btn.style.setProperty('z-index', '10000001', 'important');
                      btn.style.setProperty('display', 'flex', 'important');
                      btn.style.setProperty('visibility', 'visible', 'important');
                      btn.style.setProperty('opacity', '1', 'important');
                      btn.style.setProperty('width', '2.5rem', 'important');
                      btn.style.setProperty('height', '2.5rem', 'important');
                      btn.style.setProperty('min-width', '2.5rem', 'important');
                      btn.style.setProperty('min-height', '2.5rem', 'important');
                    });
                    
                    zoomControlsContainerAgain.style.setProperty('z-index', '10000000', 'important');
                    zoomControlsContainerAgain.style.setProperty('display', 'flex', 'important');
                    zoomControlsContainerAgain.style.setProperty('flex-direction', 'column', 'important');
                    zoomControlsContainerAgain.style.setProperty('visibility', 'visible', 'important');
                    zoomControlsContainerAgain.style.setProperty('opacity', '1', 'important');
                    zoomControlsContainerAgain.style.setProperty('position', 'absolute', 'important');
                    zoomControlsContainerAgain.style.setProperty('left', '0.5rem', 'important');
                    zoomControlsContainerAgain.style.setProperty('top', '50%', 'important');
                    zoomControlsContainerAgain.style.setProperty('transform', 'translateY(-50%)', 'important');
                    zoomControlsContainerAgain.style.setProperty('gap', '0.25rem', 'important');
                    
                    const rectAgain = zoomControlsContainerAgain.getBoundingClientRect();
                    console.log('[Step 9.5] Zoom controls container after invalidateSize: top = ' + rectAgain.top + ', left = ' + rectAgain.left + ', width = ' + rectAgain.width + ', height = ' + rectAgain.height);
                  }
                  
                  if (mapEl) {
                    const rect = mapEl.getBoundingClientRect();
                    console.log('[Step 9] After invalidateSize in setTimeout: mapEl.bottom = ' + rect.bottom + 'px');
                  }
                  
                  // Еще раз принудительно устанавливаем позиционирование после invalidateSize
                  requestAnimationFrame(() => {
                    if (mapEl) {
                      const rectBefore = mapEl.getBoundingClientRect();
                      console.log('[Step 10] In requestAnimationFrame, before forcing: mapEl.bottom = ' + rectBefore.bottom + 'px');
                      
                      mapEl.style.top = '0';
                      mapEl.style.left = '0';
                      mapEl.style.right = '0';
                      mapEl.style.bottom = '0';
                      mapEl.style.position = 'absolute';
                      mapEl.style.height = finalVh + 'px';
                      mapEl.style.minHeight = finalVh + 'px';
                      mapEl.style.maxHeight = finalVh + 'px';
                      mapEl.style.margin = '0';
                      mapEl.style.transform = 'none';
                      mapEl.style.inset = '0';
                      
                      const rectAfter = mapEl.getBoundingClientRect();
                      console.log('[Step 10] After forcing in requestAnimationFrame: mapEl.bottom = ' + rectAfter.bottom + 'px');
                      console.log('[Step 10] mapEl.style.height = ' + mapEl.style.height + ', mapEl.style.top = ' + mapEl.style.top);
                      console.log('[Step 10] Computed style: height = ' + window.getComputedStyle(mapEl).height + ', top = ' + window.getComputedStyle(mapEl).top);
                    }
                    if (frame) {
                      frame.style.top = '0';
                      frame.style.left = '0';
                      frame.style.right = '0';
                      frame.style.bottom = '0';
                      frame.style.position = 'absolute';
                      frame.style.height = finalVh + 'px';
                      frame.style.minHeight = finalVh + 'px';
                      frame.style.maxHeight = finalVh + 'px';
                    }
                    if (ratioBox) {
                      ratioBox.style.top = '0';
                      ratioBox.style.left = '0';
                      ratioBox.style.right = '0';
                      ratioBox.style.bottom = '0';
                      ratioBox.style.position = 'absolute';
                      ratioBox.style.height = finalVh + 'px';
                      ratioBox.style.minHeight = finalVh + 'px';
                      ratioBox.style.maxHeight = finalVh + 'px';
                    }
                    
                    // Координаты экрана (viewport)
                    const viewportTop = 0;
                    const viewportBottom = getViewportHeight();
                    
                    // Координаты карты (контейнера)
                    const mapContainer = map.getContainer();
                    const mapRect = mapContainer.getBoundingClientRect();
                    const mapTop = mapRect.top;
                    const mapBottom = mapRect.bottom;
                    
                    // Координаты изображения карты
                    const imgLayerEl = mapContainer.querySelector('.leaflet-image-layer');
                    let imgTop = null;
                    let imgBottom = null;
                    
                    if (imgLayerEl) {
                      const imgRect = imgLayerEl.getBoundingClientRect();
                      imgTop = imgRect.top;
                      imgBottom = imgRect.bottom;
                    }
                    
                    // Координаты в системе координат Leaflet
                    const mapBounds = map.getBounds();
                    const mapTopLatLng = map.containerPointToLatLng([mapRect.width / 2, 0]);
                    const mapBottomLatLng = map.containerPointToLatLng([mapRect.width / 2, mapRect.height]);
                    
                    console.log('=== Fullscreen Mode - Coordinates ===');
                    console.log('Screen (viewport):');
                    console.log('  Top: ' + viewportTop + 'px');
                    console.log('  Bottom: ' + viewportBottom + 'px');
                    console.log('Map Container:');
                    console.log('  Top: ' + mapTop + 'px');
                    console.log('  Bottom: ' + mapBottom + 'px');
                    console.log('Image Layer:');
                    console.log('  Top: ' + (imgTop !== null ? imgTop + 'px' : 'null'));
                    console.log('  Bottom: ' + (imgBottom !== null ? imgBottom + 'px' : 'null'));
                    console.log('Map Coordinates (Leaflet):');
                    console.log('  Top center: ' + JSON.stringify({lat: mapTopLatLng.lat, lng: mapTopLatLng.lng}));
                    console.log('  Bottom center: ' + JSON.stringify({lat: mapBottomLatLng.lat, lng: mapBottomLatLng.lng}));
                    console.log('  Bounds: ' + JSON.stringify({
                      north: mapBounds.getNorth(),
                      south: mapBounds.getSouth(),
                      east: mapBounds.getEast(),
                      west: mapBounds.getWest()
                    }));
                  });
                }, 200);
              });
            };

            const exitMobileFs = () => {
              // КРИТИЧНО: Сначала восстанавливаем все стили элементов
              // Удаляем все inline-стили, установленные через setProperty с !important
              if (viewer) {
                viewer.style.removeProperty('position');
                viewer.style.removeProperty('top');
                viewer.style.removeProperty('left');
                viewer.style.removeProperty('right');
                viewer.style.removeProperty('bottom');
                viewer.style.removeProperty('width');
                viewer.style.removeProperty('height');
                viewer.style.removeProperty('min-height');
                viewer.style.removeProperty('max-height');
                viewer.style.removeProperty('margin');
                viewer.style.removeProperty('padding');
                viewer.style.removeProperty('z-index');
                viewer.style.removeProperty('transform');
                viewer.style.removeProperty('overflow');
                viewer.style.removeProperty('will-change');
              }
              
              // Восстанавливаем стили родительских элементов
              let parent = viewer?.parentElement;
              let parentLevel = 0;
              while (parent && parentLevel < 5) {
                parent.style.removeProperty('margin');
                parent.style.removeProperty('padding');
                parent.style.removeProperty('margin-top');
                parent.style.removeProperty('padding-top');
                parent.style.removeProperty('transform');
                parent = parent.parentElement;
                parentLevel++;
              }
              
              // Восстанавливаем scroll position
              document.documentElement.style.overflow = '';
              document.body.style.overflow = '';
              
              // Удаляем классы
              viewer.classList.remove('fullscreen-mobile');
              document.body.classList.remove('fullscreen-mobile-active');
              document.documentElement.classList.remove('fullscreen-mobile-active');

              const header = document.querySelector('header');
              const footer = document.querySelector('footer');
              if (header) { header.style.display = ''; header.removeAttribute('data-fullscreen-hidden'); }
              if (footer) { footer.style.display = ''; footer.removeAttribute('data-fullscreen-hidden'); }

              // Восстанавливаем оригинальные стили body и html
              const body = document.body;
              const html = document.documentElement;
              
              if (body.dataset.originalBodyStyle) {
                const original = JSON.parse(body.dataset.originalBodyStyle);
                body.style.margin = original.margin || '';
                body.style.padding = original.padding || '';
                body.style.overflow = original.overflow || '';
                body.removeAttribute('data-original-body-style');
              } else {
                // Если не сохраняли, просто очищаем
                body.style.margin = '';
                body.style.padding = '';
                body.style.overflow = '';
              }
              
              if (html.dataset.originalHtmlStyle) {
                const original = JSON.parse(html.dataset.originalHtmlStyle);
                html.style.margin = original.margin || '';
                html.style.padding = original.padding || '';
                html.style.overflow = original.overflow || '';
                html.removeAttribute('data-original-html-style');
              } else {
                // Если не сохраняли, просто очищаем
                html.style.margin = '';
                html.style.padding = '';
                html.style.overflow = '';
              }

              // Восстанавливаем режим ratio
              restoreRatioMode();
              
              // Убеждаемся, что viewer снова видим и имеет правильные размеры
              requestAnimationFrame(() => {
                // Убеждаемся, что все дочерние элементы также восстановлены
                if (ratioBox) {
                  ratioBox.style.removeProperty('position');
                  ratioBox.style.removeProperty('top');
                  ratioBox.style.removeProperty('left');
                  ratioBox.style.removeProperty('right');
                  ratioBox.style.removeProperty('bottom');
                  ratioBox.style.removeProperty('width');
                  ratioBox.style.removeProperty('height');
                  ratioBox.style.removeProperty('min-height');
                  ratioBox.style.removeProperty('max-height');
                  ratioBox.style.removeProperty('transform');
                }
                
                if (frame) {
                  frame.style.removeProperty('position');
                  frame.style.removeProperty('top');
                  frame.style.removeProperty('left');
                  frame.style.removeProperty('right');
                  frame.style.removeProperty('bottom');
                  frame.style.removeProperty('width');
                  frame.style.removeProperty('height');
                  frame.style.removeProperty('min-height');
                  frame.style.removeProperty('max-height');
                  frame.style.removeProperty('transform');
                }
                
                if (mapEl) {
                  mapEl.style.removeProperty('position');
                  mapEl.style.removeProperty('top');
                  mapEl.style.removeProperty('left');
                  mapEl.style.removeProperty('right');
                  mapEl.style.removeProperty('bottom');
                  mapEl.style.removeProperty('width');
                  mapEl.style.removeProperty('height');
                  mapEl.style.removeProperty('min-height');
                  mapEl.style.removeProperty('max-height');
                  mapEl.style.removeProperty('margin');
                  mapEl.style.removeProperty('transform');
                  mapEl.style.removeProperty('inset');
                }
                
                applyMapInsetsToBorder();
                map.invalidateSize(false);
                map.fitBounds(bounds, { animate: false, padding: [0, 0] });
                
                // Убеждаемся, что viewer видим
                if (viewer) {
                  const viewerRect = viewer.getBoundingClientRect();
                  console.log('[Exit Fullscreen] Viewer restored: top = ' + viewerRect.top + ', height = ' + viewerRect.height);
                }
              });
            };

            const toggleFullscreen = () => {
              if (isMobile()) {
                if (!viewer.classList.contains('fullscreen-mobile')) {
                  enterMobileFs();
              } else {
                  exitMobileFs();
                }
                return;
              }

              // Десктоп: Fullscreen API
              if (!document.fullscreenElement && viewer.requestFullscreen) {
                viewer.requestFullscreen().catch(e => console.error('FS request failed:', e));
              } else if (document.fullscreenElement && document.exitFullscreen) {
                document.exitFullscreen().catch(e => console.error('FS exit failed:', e));
              }
            };

            btnFS?.addEventListener('click', toggleFullscreen);

            // Fullscreen события (десктоп)
            const onFsChange = () => {
              const isFs = !!document.fullscreenElement;
              setTimeout(() => {
                applyMapInsetsToBorder();
                if (isFs) {
                  // на десктопе при переходе в fullscreen пусть fitBounds будет по высоте
                  fitPreferHeight(map, bounds);
                } else {
                  map.invalidateSize(false);
                  map.fitBounds(bounds, { animate: false, padding: [0, 0] });
                }
              }, 80);
            };
            document.addEventListener('fullscreenchange', onFsChange);
            document.addEventListener('webkitfullscreenchange', onFsChange);
            document.addEventListener('mozfullscreenchange', onFsChange);
            document.addEventListener('MSFullscreenChange', onFsChange);

            // -----------------------
            // Обработчики изменения viewport (visualViewport preferred)
            // -----------------------
            const onViewportResize = debounce(() => {
              applyMapInsetsToBorder();
              if (viewer.classList.contains('fullscreen-mobile') && isMobile()) {
                const vh = getViewportHeight();
                setFullscreenPixelSizes(vh);
                requestAnimationFrame(() => fitPreferHeight(map, bounds));
              } else {
                requestAnimationFrame(() => {
                  restoreRatioMode();
                  map.invalidateSize(false);
                  map.fitBounds(bounds, { animate: false, padding: [0, 0] });
                });
              }
            }, 120);

            if (window.visualViewport) {
              window.visualViewport.addEventListener('resize', onViewportResize);
              window.visualViewport.addEventListener('scroll', onViewportResize);
            }
            window.addEventListener('resize', onViewportResize);
            window.addEventListener('orientationchange', onViewportResize);

            // Финальный safety-fit после загрузки
              setTimeout(() => {
                applyMapInsetsToBorder();
              fitPreferHeight(map, bounds);
            }, 300);
          }; // img.onload end
        });
      </script>

