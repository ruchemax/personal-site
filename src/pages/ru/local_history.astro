---
import LocalHistoryLayout from "../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

// даты публикаций для разных материалов
const publishedMap = new Date("2025-10-26").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const publishedBook = new Date("2025-10-26").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const publishedPetition = new Date("2025-10-26").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const publishedPetition2 = new Date("2025-11-08").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const publishedMapCherepovskaya1677 = new Date("2025-11-16").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<LocalHistoryLayout 
  title="Краеведение — Максим Ручкин" 
  description="Материалы по истории Череповецкого края: карты земельных владений XVII века, переписные книги, исторические документы и исследования."
  lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1000px] px-6 py-14">
      <h1 class="text-3xl font-bold">Краеведение</h1>

      <!-- Описание раздела -->
      <div class="mt-6 space-y-4 text-sm text-white/90 leading-relaxed text-justify">
        <p>
          Раздел посвящен истории Череповецкого края. Здесь я выкладываю набранные мной архивные документы и составленные на их основе карты.
        </p>
      </div>

      <div class="mt-6 space-y-6">
        <div class="space-y-4">
          <!-- Карточка 4 - Карта земельных владений в Череповской волости (1677–79 гг.) -->
          <a
            href="/ru/local_history/cherepovskaya-map-1677"
            class="block rounded-xl border border-white/10 bg-black/40 p-4 hover:border-amber-400 transition"
          >
            <div class="text-xs text-white/60 mb-2">Опубликовано: {publishedMapCherepovskaya1677}</div>

            <h3 class="text-xl font-medium">
              Карта земельных владений в Череповской волости (1677–79 гг.)
            </h3>

            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Белозерский уезд</span>
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Надпорожский стан</span>
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Череповская волость</span>
            </div>
          </a>

          <!-- Карточка 3 - Челобитная 2-->
          <a
            href="/ru/local_history/zayakoshie"
            class="block rounded-xl border border-white/10 bg-black/40 p-4 hover:border-amber-400 transition"
          >
            <div class="text-xs text-white/60 mb-2">Опубликовано: {publishedPetition2}</div>

            <h3 class="text-xl font-medium">
              Церковь Бориса и Глеба в д. Заякошье Череповской волости
            </h3>

            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Белозерский уезд</span>
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Надпорожский стан</span>
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Череповская волость</span>
              <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">д. Заякошье</span>
            </div>
          </a>

          <div class="space-y-4">
            <!-- Карточка 2 - Карта -->
            <a
              href="/ru/local_history/cherepovets-map-1626"
              class="block rounded-xl border border-white/10 bg-black/40 p-4 hover:border-amber-400 transition"
            >
              <div class="text-xs text-white/60 mb-2">Опубликовано: {publishedMap}</div>

              <h3 class="text-xl font-medium">
                Карта земельных владений в волости Череповец (1626/27 г.)
              </h3>

              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Белозерский уезд</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Надпорожский стан</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Череповская волость</span>
              </div>
            </a>

            <!-- Карточка 1 - Переписная книга -->
            <a
              href="/ru/local_history/churovskaya-book-1677"
              class="block rounded-xl border border-white/10 bg-black/40 p-4 hover:border-amber-400 transition"
            >
              <div class="text-xs text-white/60 mb-2">Опубликовано: {publishedBook}</div>

              <h3 class="text-xl font-medium">
                Перепись Чуровской волости (1677-1679 г.)
              </h3>

              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Белозерский уезд</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Надпорожский стан</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Чуровская волость</span>
              </div>
            </a>
          </div>
      </div>
    </div>
  </div>
  </section>
</LocalHistoryLayout>


