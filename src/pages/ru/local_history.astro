---
import LocalHistoryLayout from "../../layouts/LocalHistoryLayout.astro";

const { lang = "ru" } = Astro.props;

const sections = [
  {
    title: "Белозерье",
    href: "/ru/local_history/belozerye",
    image: "/images/local-history/belozerye.webp",
  },
  {
    title: "Южный Урал",
    href: "/ru/local_history/southern-urals",
    image: "/images/local-history/southern-urals.webp",
  },
];
---

<LocalHistoryLayout
  title="Краеведение и генеалогия — Максим Ручкин"
  description="Материалы по краеведению и генеалогии Белозерья и Южного Урала."
  lang={lang}
  backgroundUrl="/images/background/local-history-map-bg.webp"
  backgroundOverlay={0}
>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1100px] px-6 py-14">
      <h1 class="text-center text-3xl font-bold">Краеведение и генеалогия</h1>

      <div class="history-tiles">
        {sections.map((section) => (
          <a
            href={section.href}
            class="history-tile group relative isolate flex items-center justify-center overflow-hidden rounded-[2rem] border border-white/20 bg-black text-center shadow-2xl transition duration-300 hover:-translate-y-1 hover:border-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
          >
            <img
              src={section.image}
              alt=""
              class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="eager"
            />
            <span class="absolute inset-0 -z-10 bg-gradient-to-t from-black/80 via-black/25 to-black/10"></span>
            <h2 class="tile-title text-3xl font-semibold transition-colors group-hover:text-amber-300 lg:text-4xl">
              {section.title}
            </h2>
          </a>
        ))}
      </div>
    </div>
  </section>
</LocalHistoryLayout>

<style>
  .history-tiles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 2.5rem auto 0;
  }

  .history-tile {
    display: flex;
    width: 440px;
    height: 440px;
    min-width: 440px;
    flex: 0 0 440px;
    border: 3px solid rgba(255, 255, 255, 0.95);
    border-radius: 2rem;
  }

  .tile-title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 2rem;
    text-align: center;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.95), 0 0 18px rgba(0, 0, 0, 0.8);
    transform: translate(-50%, -50%);
  }

  @media (max-width: 980px) {
    .history-tile {
      width: min(42vw, 400px);
      height: min(42vw, 400px);
      min-width: min(42vw, 400px);
      flex-basis: min(42vw, 400px);
    }
  }

  @media (max-width: 640px) {
    .history-tiles {
      flex-direction: column;
    }

    .history-tile {
      width: min(88vw, 440px);
      height: min(88vw, 440px);
      min-width: min(88vw, 440px);
      flex-basis: min(88vw, 440px);
    }
  }
</style>
