---
import BaseLayout from "../../layouts/BaseLayout.astro";

const { lang = "ru" } = Astro.props;

// та же дата, что и в самой странице
const publishedAt = new Date("2025-09-22").toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title="Хобби — Максим Ручкин" lang={lang}>
  <section class="w-full text-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 py-16">
      <h1 class="text-4xl font-bold">Хобби</h1>

      <div class="mt-10 space-y-8">
        <article class="rounded-2xl border border-white/10 bg-black/20 p-6 shadow-lg backdrop-blur">
          <h2 class="text-2xl font-semibold">
            Краеведение и генеалогия (Череповецкий край)
          </h2>

          <div class="mt-6 space-y-4">
            <!-- Карточка с картой -->
            <a
              href="/ru/hobby/cherepovets-map-1626"
              class="block rounded-xl border border-white/10 bg-black/30 p-4 hover:border-amber-400 transition"
            >
              <!-- Дата публикации -->
              <div class="text-xs text-white/60 mb-2">Опубликовано: {publishedAt}</div>

              <h3 class="text-xl font-medium">
                Карта земельных владений в волости Череповец (1626/27 г.)
              </h3>

              <!-- Теги -->
              <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Белозерский уезд</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Надпорожский стан</span>
                <span class="rounded-full bg-amber-500/20 px-3 py-1 text-amber-300">Череповская волость</span>
              </div>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

